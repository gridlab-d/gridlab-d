{
  "clock": {
    "timezone": "PST+8PDT",
    "timestamp": "'2001-01-01 0:00:00'",
    "stoptime": "'2001-01-02 0:00:00'"
  },
  "modules": {
    "climate": {},
    "residential": {
      "implicit_enduses": "NONE"
    },
    "tape": {}
  },
  "objects": {
    "csv_reader": {
      "instances": [
        {
          "name": "CsvReader",
          "filename": "../weather_dst.csv"
        }
      ]
    },
    "recorder": {
      "instances": [
        {
          "name": "recorder_3",
          "parent": "MyClimate",
          "file": "climate_out.csv",
          "interval": 3600,
          "limit": 120,
          "property": "temperature,humidity"
        },
        {
          "name": "recorder_5",
          "parent": "house_4",
          "file": "house_out.csv",
          "interval": 3600,
          "limit": 24,
          "property": "outdoor_temperature,outdoor_rh"
        }
      ]
    },
    "climate": {
      "instances": [
        {
          "name": "MyClimate",
          "tmyfile": "../weather_dst.csv",
          "reader": "CsvReader"
        }
      ]
    },
    "house": {
      "instances": [
        {
          "name": "house_4"
        }
      ]
    }
  }
