{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug GridLAB-D (WSL2 Native)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/out/build/wsl2-native/bin/gridlabd",
            "args": [
                "--validate",
                "--threadcount",
                " 2"
            ],
            "cwd": "${workspaceFolder}/climate",
            "environment": [
                {
                    "name": "GLPATH",
                    "value": "${workspaceFolder}/modules/powerflow:${workspaceFolder}/out/build/wsl2-native:${workspaceFolder}/gldcore"
                }
            ],
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "stopAtEntry": false,
            "externalConsole": false,
        },
        {
            "name": "Attach to gridlabd",
            "type": "cppvsdbg",
            "request": "attach",
            "processId": "${command:pickProcess}"
        },
        { // This is the start of the "Debug GridLAB-D" configuration object
            "name": "Debug GridLAB-D",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/out/build/vs-generate-project-files/bin/Debug/gridlabd.exe",
            "args": [
                "test_inverter_dyn_Imax_PAC.glm",
                "--verbose"
            ],
            "cwd": "${workspaceFolder}/generators/autotest/test_inverter_dyn_Imax_PAC",
            "environment": [
                {
                    "name": "GLPATH",
                    "value": "${workspaceFolder}/out/build/vs-generate-project-files/share;${workspaceFolder}/out/build/vs-generate-project-files/bin/Debug;${workspaceFolder}/gldcore"
                },
                {
                    "name": "PATH",
                    "value": "${env:PATH};${workspaceFolder}/out/build/vs-generate-project-files/bin/Debug"
                }
            ],
            "console": "integratedTerminal",
            "stopAtEntry": false,
            "symbolSearchPath": "${workspaceFolder}/out/build/vs-generate-project-files/bin/Debug", // <--- ADDED COMMA HERE
        } // This is the end of the "Debug GridLAB-D" configuration object
    ]
}