{
  "__preamble": {
    "comments": [
      "//test_microwave_implicit_swd.glm",
      "//this program contains one house with a single microwave using the implicit schedule and the hvac turned off",
      "//this program will validate power through energy usage as well as energy.",
      "//by d3y334"
    ]
  },
  "clock": {
    "timestamp": "'2001-05-05 0:00:00'",
    "stoptime": "'2001-05-06 2:00:00'",
    "timezone": "PST+8PDT"
  },
  "modules": {
    "residential": {
      "implicit_enduses": "MICROWAVE"
    },
    "tape": {},
    "assert": {}
  },
  "objects": {
    "complex_assert": {
      "instances": [
        {
          "parent": "house_1",
          "in": "'2001-05-06 1:00:00'",
          "once": "ONCE_TRUE",
          "target": "panel.energy",
          "value": "0.025+0.025j",
          "within": 0.01
        }
      ]
    },
    "recorder": {
      "instances": [
        {
          "parent": "house_1",
          "property": "panel.energy",
          "file": "test_microwave_implicit_swd.csv",
          "interval": 3600,
          "limit": 24
        }
      ]
    },
    "house": {
      "instances": [
        {
          "name": "house_1",
          "heating_setpoint": 5,
          "cooling_setpoint": 300,
          "air_temperature": 70,
          "outdoor_temperature": 73
        }
      ]
    }
  }
}