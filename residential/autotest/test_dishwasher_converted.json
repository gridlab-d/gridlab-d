          "queue": 1,
          "queue_min": 0,
          "queue_max": 2,
          "inside_comments": [
            "//myshape \"type: modulated; schedule: DRYER; energy: 2.8890 kWh; period: 60.000 s; count: 12; modulation: amplitude\";",
            "//name direct-gpm1_R1-12-47-2_tn_252;",
            "//dishwasher_demand this.myshape;"
