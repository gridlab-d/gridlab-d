  "objects": {
    "player": {
      "instances": [
        {
          "name": "player_4",
          "parent": "double_assert_3",
          "property": "value",
          "file": "../dishwasher_output.player"
        }
      ]
    },
    "double_assert": {
      "instances": [
        {
          "name": "double_assert_3",
          "parent": "dishwasher_2",
          "target": "total_power",
          "within": 0.1
        }
      ]
    },
    "recorder": {
      "instances": [
        {
          "name": "recorder_5",
          "parent": "dishwasher_2",
          "property": "total_power,energy_used,energy_needed,queue,dishwasher_run_prob,daily_dishwasher_demand",
          "interval": 1,
          "limit": 1296020,
          "file": "Dishwasher_output.csv"
        }
      ]
    },
    "dishwasher": {
      "instances": [
        {
          "name": "dishwasher_2",
          "parent": "house_1",
