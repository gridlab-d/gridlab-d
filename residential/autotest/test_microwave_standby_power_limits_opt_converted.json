{
  "__preamble": {
    "comments": [
      "//Power limits Test",
      "//test_microwave_standby_power_limits.glm",
      "//This is a test to see that the auto-correction works correctly for standby_power.",
      "//The default value for standby_power is 1% of installed_power"
    ]
  },
  "clock": {
    "starttime": "'2000-01-01 00:00:00'",
    "stoptime": "'2001-01-01 00:00:00'",
    "timezone": "PST+8PDT"
  },
  "modules": {
    "residential": {},
    "tape": {},
    "assert": {}
  },
  "objects": {
    "house": {
      "instances": [
        {
          "object_declaration": "house:1"
        }
      ]
    },
    "microwave": {
      "instances": [
        {
          "object_declaration": "microwave:2",
          "parent": "house:1",
          "installed_power": "1000 W",
          "standby_power": "-100 W"
        }
      ]
    },
    "recorder": {
      "instances": [
        {
          "object_declaration": "recorder:3",
          "parent": "microwave:2",
          "property": "standby_power,installed_power,cycle_length,constant_power,constant_current",
          "file": "test_microwave_standby_power_limits.csv",
          "interval": 1,
          "limit": 10
        }
      ]
    },
    "player": {
      "instances": [
        {
          "parent": "double_assert:4",
          "property": "value",
          "file": "test_microwave_standby_power_limits.player",
          "inline_comments": {
            "file": "//standby_power should = 10 W"
          }
        }
      ]
    },
    "double_assert": {
      "instances": [
        {
          "object_declaration": "double_assert:4",
          "parent": "microwave:2",
          "status": "ASSERT_TRUE",
          "target": "standby_power",
          "within": 0.001
        }
      ]
    }
  }
}