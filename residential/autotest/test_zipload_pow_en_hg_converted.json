{
  "__preamble": {
    "comments": [
      "// test_zipload_pow_en_hg.glm tests to see if power, energy, and heatgain is being properly calculated in zipload.cpp and passed to the house.",
      "// The file contains a triplex meter with a single house attached to it.",
      "// The house contains a single zipload object and the house's HVAC system is turned off"
    ]
  },
  "_directives": {
    "#set": {
      "minimum_timestep": "3600;"
    }
  },
  "clock": {
    "timezone": "PST+8PDT",
    "starttime": "'2001-01-01 00:00:00'",
    "stoptime": "'2001-01-02 00:00:00'"
  },
  "modules": {
    "powerflow": {},
    "residential": {
      "implicit_enduses": "NONE"
    },
    "tape": {},
    "assert": {}
  },
  "objects": {
    "complex_assert": {
      "instances": [
        {
          "name": "complex_assert_4",
          "parent": "ZIPload_3",
          "target": "power",
          "once": "ONCE_FALSE",
          "value": "1+0.033856i",
          "within": 1e-06
        },
        {
          "name": "complex_assert_5",
          "parent": "ZIPload_3",
          "target": "energy",
          "in": "'2001-01-02 00:00:00'",
          "once": "ONCE_TRUE",
          "value": "24+0.812533i",
          "within": 1e-06
        },
        {
          "name": "complex_assert_7",
          "parent": "house_2",
          "target": "panel.power",
          "once": "ONCE_FALSE",
          "value": "1+0.033856i",
          "within": 1e-06
        },
        {
          "name": "complex_assert_8",
          "parent": "house_2",
          "target": "panel.energy",
          "in": "'2001-01-02 00:00:00'",
          "once": "ONCE_TRUE",
          "value": "24+0.812533i",
          "within": 1e-06
        },
        {
          "name": "complex_assert_10",
          "parent": "triplex_meter_1",
          "target": "measured_power",
          "once": "ONCE_FALSE",
          "value": "1000.573+1.939d",
          "within": 0.001
        }
      ]
    },
    "double_assert": {
      "instances": [
        {
          "name": "double_assert_6",
          "parent": "ZIPload_3",
          "target": "heatgain",
          "once": "ONCE_FALSE",
          "value": 2729.6,
          "within": 0.01
        },
        {
          "name": "double_assert_9",
          "parent": "house_2",
          "target": "internal_gain",
          "once": "ONCE_FALSE",
          "value": 2729.6,
          "within": 0.01
        },
        {
          "name": "double_assert_11",
          "parent": "triplex_meter_1",
          "target": "measured_real_energy",
          "in": "'2001-01-02 00:00:00'",
          "once": "ONCE_TRUE",
          "value": 24000,
          "within": 1e-06
        },
        {
          "name": "double_assert_12",
          "parent": "triplex_meter_1",
          "target": "measured_reactive_energy",
          "in": "'2001-01-02 00:00:00'",
          "once": "ONCE_TRUE",
          "value": 812.533401,
          "within": 1e-06
        }
      ]
    },
    "ZIPload": {
      "instances": [
        {
          "name": "ZIPload_3",
          "parent": "house_2",
          "heat_fraction": 0.8,
          "base_power": 1,
          "power_pf": -0.9,
          "power_fraction": 0.25,
          "current_pf": 0.85,
          "current_fraction": 0.25,
          "impedance_pf": 1,
          "impedance_fraction": 0.5,
          "inline_comments": {
            "base_power": "//base real power is 1 kW"
          }
        }
      ]
    },
    "house": {
      "instances": [
        {
          "name": "house_2",
          "parent": "triplex_meter_1",
          "system_mode": "OFF",
          "auxiliary_strategy": "NONE",
          "heating_system_type": "NONE",
          "cooling_system_type": "NONE",
          "auxiliary_system_type": "NONE",
          "air_temperature": 60,
          "mass_temperature": 60
        }
      ]
    },
    "triplex_meter": {
      "instances": [
        {
          "name": "triplex_meter_1",
          "nominal_voltage": 120,
          "phases": "AS"
        }
      ]
    }
  }
}