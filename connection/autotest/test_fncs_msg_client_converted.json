{
  "__preamble": {
    "comments": [
      "// $Id$",
      "//",
      "// This test can be started either from the client or the server script.",
      "// Each will automatically start the other to provide the other side of",
      "// the test.",
      "//",
      "// specify how long to wait after server start (in seconds)",
      "// #ifdef PYTHON",
      "// // use python server",
      "// #sleep ${wait}000",
      "// #else",
      "// #ifndef NOSERVER",
      "// // use gridlabd server",
      "// #ifdef WINDOWS",
      "// #else",
      "// #endif",
      "// #sleep ${wait}000",
      "// #endif",
      "// #endif"
    ]
  },
  "_directives": {
    "#define": {
      "wait": 1
    },
    "#set": {
      "maximum_synctime": "3600;"
    }
  },
  "_legacy": {
    "#system": [
      "start python json_link_demo.py --udp --port=39036",
      "\"start ${exename} -D verbose=${verbose} -D debug=${debug} -D NOCLIENT=1 test_json_server.glm\"",
      "\"${exename} -D verbose=${verbose} -D debug=${debug} -D NOCLIENT=1 test_json_server.glm &\""
    ]
  },
  "classes": {
    "auction": [
      {
        "type": "double",
        "name": "current_price_mean_1h"
      },
      {
        "type": "double",
        "name": "current_price_stdev_1h"
      }
    ]
  },
  "clock": {
    "timezone": "PST+8PDT",
    "starttime": "'2001-06-25 14:00:00'",
    "stoptime": "'2001-06-25 16:00:00'",
    "outside_print": [
      "Starting pything server...",
      "Server started...",
      "Starting gridlabd server...",
      "Waiting ${wait} seconds...",
      "Server started..."
    ]
  },
  "modules": {
    "climate": {},
    "connection": {
      "security": "STANDARD",
      "lockout": "1 min"
    },
    "market": {},
    "powerflow": {},
    "residential": {
      "implicit_enduses": "NONE"
    },
    "tape": {}
  },
  "objects": {
    "climate": {
      "instances": [
        {
          "name": "Yakima WA",
          "tmyfile": "WA-Yakima.tmy2"
        }
      ]
    },
    "recorder": {
      "instances": [
        {
          "parent": "Market_1",
          "property": "current_price_mean_1h,current_price_stdev_1h,market_id,current_market.clearing_price",
          "file": "test_fncs_msg_client_auction.csv",
          "interval": -1
        },
        {
          "parent": "C_1",
          "property": "proxy_average,proxy_standard_deviation,proxy_market_id,proxy_clear_price",
          "file": "test_fncs_msg_client_proxy.csv",
          "interval": 0
        }
      ]
    },
    "auction": {
      "instances": [
        {
          "name": "Market_1",
          "unit": "MW",
          "period": 300,
          "special_mode": "BUYERS_ONLY",
          "fixed_price": "fixed_prices*1",
          "warmup": 0,
          "init_price": 50,
          "init_stdev": 15,
          "price_cap": 110
        }
      ]
    },
    "fncs_msg": {
      "instances": [
        {
          "name": "GLD1",
          "parent": "Market_1",
          "publish": "function:controller/submit_bid_state -> auction/submit_bid_state",
          "subscribe": "presync:C_1.proxy_standard_deviation <- GLD1/var4",
          "option": "transport:hostname localhost, port 5570"
        }
      ]
    },
    "controller": {
      "instances": [
        {
          "name": "C_1",
          "parent": "house1",
          "bid_id": 13,
          "market": "Market_1",
          "bid_mode": "PROXY",
          "period": 300,
          "average_target": "current_price_mean_1h",
          "standard_deviation_target": "current_price_stdev_1h",
          "control_mode": "RAMP",
          "target": "air_temperature",
          "setpoint": "cooling_setpoint",
          "demand": "cooling_demand",
          "total": "total_load",
          "load": "hvac_load",
          "ramp_low": 2,
          "ramp_high": 2,
          "range_low": -3,
          "range_high": 5,
          "proxy_average": 50,
          "proxy_standard_deviation": 15,
          "proxy_market_id": 1,
          "proxy_clear_price": 50,
          "proxy_price_cap": 110,
          "proxy_market_unit": "MW",
          "proxy_initial_price": 50
        }
      ]
    },
    "house": {
      "instances": [
        {
          "name": "house1",
          "parent": "triplex_meter_5",
          "cooling_setpoint": 70,
          "heating_setpoint": 55,
          "air_temperature": 72
        }
      ]
    },
    "triplex_meter": {
      "instances": [
        {
          "name": "triplex_meter_5",
          "phases": "AS",
          "nominal_voltage": 120,
          "bustype": "SWING"
        }
      ]
    }
  },
  "schedules": {
    "fixed_prices": [
      {
        "name": "",
        "items": [
          "0-14 * * * * 100",
          "15-29 * * * * 10",
          "30-44 * * * * 25",
          "45-59 * * * * 112"
        ]
      }
    ]
  }
}