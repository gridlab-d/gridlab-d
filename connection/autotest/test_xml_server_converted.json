{
  "__preamble": {
    "comments": [
      "// $Id$"
    ]
  },
  "classes": {
    "test": [
      {
        "type": "double",
        "name": "x"
      },
      {
        "type": "double",
        "name": "y"
      }
    ]
  },
  "modules": {
    "connection": {
      "security": "STANDARD",
      "lockout": "1 min"
