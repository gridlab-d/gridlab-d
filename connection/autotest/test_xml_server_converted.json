        {
          "link": "sync:my.y <- var2",
          "option": "server:maxclients 1",
          "inside_comments": [
            "// option \"transport:udp\";",
            "// option \"readcache:size 1024\";",
            "// option \"writecache:size 1024\";"
          ],
          "inline_comments": {
            "option": "// pass options one at a time"
          }
        },
        {
          "mode": "SERVER",
          "transport": "UDP"
        }
      ]
    }
  }
