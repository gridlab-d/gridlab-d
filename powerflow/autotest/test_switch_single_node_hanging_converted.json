{
  "__preamble": {
    "comments": [
      "//Variation of 4-node feeder",
      "//Checks \"switch-like\" devices on initial open",
      "//This whole autotest is effectively deprecated by mesh topology checking mode",
      "//But still need to make sure this works",
      "//If it is run in older versions of GLD, the powerflow diverges quickly."
    ]
  },
  "clock": {
    "timezone": "EST+5EDT",
    "starttime": "'2000-01-01 0:00:00'",
    "stoptime": "'2000-01-01 0:00:11'"
  },
  "modules": {
    "powerflow": {
      "line_capacitance": true,
      "solver_method": "NR"
    },
    "reliability": {},
    "tape": {},
    "assert": {}
  },
  "objects": {
    "fault_check": {
      "instances": [
        {
          "name": "fault_check_object",
          "check_mode": "ONCHANGE",
          "eventgen_object": "external_event_handler",
          "output_filename": "fault_check_output.txt",
          "strictly_radial": true,
          "grid_association": false
        }
      ]
    },
    "eventgen": {
      "instances": [
        {
          "name": "external_event_handler",
          "manual_outages": "sw_node34,2001-01-01 00:00:05,2001-01-01 00:00:30",
          "inside_comments": [
            "//use_external_faults TRUE;"
          ]
        }
      ]
    },
    "overhead_line_conductor": {
      "instances": [
        {
          "name": "olc100",
          "geometric_mean_radius": "0.0244 ft",
          "resistance": "0.306 Ohm/mile",
          "diameter": "0.721 in"
        },
        {
          "name": "olc101",
          "geometric_mean_radius": "0.00814 ft",
          "resistance": "0.592 Ohm/mile",
          "diameter": "0.563 in"
        }
      ]
    },
    "line_spacing": {
      "instances": [
        {
          "name": "ls200",
          "distance_AB": "2.5 ft",
          "distance_BC": "4.5 ft",
          "distance_AC": "7.0 ft",
          "distance_AN": "5.656854 ft",
          "distance_BN": "4.272002 ft",
          "distance_CN": "5.0 ft",
          "distance_AE": "28.0 ft",
          "distance_BE": "28.0 ft",
          "distance_CE": "28.0 ft",
          "distance_NE": "24.0 ft"
        }
      ]
    },
    "line_configuration": {
      "instances": [
        {
          "name": "lc300",
          "conductor_A": "olc100",
          "conductor_B": "olc100",
          "conductor_C": "olc100",
          "conductor_N": "olc101",
          "spacing": "ls200"
        }
      ]
    },
    "transformer_configuration": {
      "instances": [
        {
          "name": "tc400",
          "connect_type": "WYE_WYE",
          "power_rating": 6000,
          "primary_voltage": 12470,
          "secondary_voltage": 4160,
          "resistance": 0.01,
          "reactance": 0.06
        }
      ]
    },
    "node": {
      "instances": [
        {
          "name": "node1",
          "bustype": "SWING",
          "phases": "ABCN",
          "voltage_A": "+7199.558+0.000j",
          "voltage_B": "-3599.779-6235.000j",
          "voltage_C": "-3599.779+6235.000j",
          "nominal_voltage": 7199.558
