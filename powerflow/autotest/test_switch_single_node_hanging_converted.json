    "recorder": {
      "instances": [
        {
          "parent": "node5",
          "property": "voltage_A,voltage_B,voltage_C",
          "interval": 1,
          "file": "test_volts.csv"
        }
      ]
    },
    "complex_assert": {
      "instances": [
        {
          "parent": "node5",
          "target": "voltage_A",
          "value": "0.0+0.0j",
          "within": 0.1
        },
        {
          "parent": "node5",
          "target": "voltage_B",
          "value": "0.0+0.0j",
          "within": 0.1
        },
        {
          "parent": "node5",
          "target": "voltage_C",
          "value": "0.0+0.0j",
          "within": 0.1
        }
      ]
    },
