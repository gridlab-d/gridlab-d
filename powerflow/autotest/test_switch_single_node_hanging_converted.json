          "configuration": "lc300",
          "inside_comments": [
            "// object recorder {",
            "// file \"line34.csv\";",
            "// interval 1;",
            "// property current_out_A,current_out_B,current_out_C,current_in_A,current_in_B,current_in_C,phases,status,from,to,power_in,power_out,power_losses,flow_direction,length,configuration;",
            "// };"
          ]
        }
      ]
