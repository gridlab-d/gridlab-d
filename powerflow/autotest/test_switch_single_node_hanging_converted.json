    "transformer": {
      "instances": [
        {
          "name": "trans23",
          "phases": "ABCN",
          "from": "node2",
          "to": "node3",
          "configuration": "tc400"
        }
      ]
    },
    "switch": {
      "instances": [
        {
          "name": "sw_node34",
          "phases": "ABC",
          "from": "node3",
          "to": "node4",
          "status": "CLOSED"
        },
        {
          "name": "sw_node45",
          "phases": "ABC",
          "from": "node3",
          "to": "node5",
          "status": "OPEN"
        }
      ]
