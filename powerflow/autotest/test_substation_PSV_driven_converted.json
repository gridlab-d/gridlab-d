{
  "__preamble": {
    "comments": [
      "// test of substation object driven by player file to positive sequence voltage, verifies the distribution voltages are calculated correctly"
    ]
  },
  "_directives": {
    "#set": {
      "minimum_timestep": "1;"
    }
  },
  "clock": {
    "timezone": "PST+8PDT",
    "starttime": "'2001-07-25 01:00:00'",
    "stoptime": "'2001-07-25 01:05:00'"
  },
  "modules": {
    "powerflow": {
      "solver_method": "FBS"
    },
    "tape": {},
    "assert": {}
  },
  "objects": {
    "player": {
      "instances": [
        {
          "name": "player_2",
          "parent": "substation_1",
          "property": "positive_sequence_voltage",
          "file": "../PSV.player",
          "loop": 1
        },
        {
          "name": "player_4",
          "parent": "complex_assert_3",
          "property": "value",
          "file": "../dist_volt_A_Aref.player",
          "loop": 1
        },
        {
          "name": "player_6",
          "parent": "complex_assert_5",
          "property": "value",
          "file": "../dist_volt_B_Aref.player",
          "loop": 1
        },
        {
          "name": "player_8",
          "parent": "complex_assert_7",
          "property": "value",
          "file": "../dist_volt_C_Aref.player",
          "loop": 1
        }
      ]
    },
    "complex_assert": {
      "instances": [
        {
          "name": "complex_assert_3",
          "parent": "substation_1",
          "target": "distribution_voltage_A",
          "within": 0.01
        },
        {
          "name": "complex_assert_5",
          "parent": "substation_1",
          "target": "distribution_voltage_B",
          "within": 0.01
        },
        {
          "name": "complex_assert_7",
          "parent": "substation_1",
          "target": "distribution_voltage_C",
          "within": 0.01
        }
      ]
    },
    "load": {
      "instances": [
        {
          "name": "load_9",
          "parent": "substation_1",
          "phases": "ABCN",
          "constant_impedance_A": "1000+2000j",
          "constant_impedance_B": "1000+1000j",
          "constant_impedance_C": "1200+800j",
          "nominal_voltage": 2400
        }
      ]
    },
    "substation": {
      "instances": [
        {
          "name": "substation_1",
          "bustype": "SWING",
          "phases": "ABCN",
          "nominal_voltage": 2400,
          "base_power": "100 MVA",
          "positive_sequence_voltage": 2400,
          "reference_phase": "PHASE_A"
        }
      ]
    }
  }
}