{
  "__preamble": {
    "comments": [
      "//Simple Three-phase induction motor test file",
      "//#set deltamode_forced_always=true"
    ]
  },
  "_directives": {
    "#set": {
      "suppress_repeat_messages": 0,
      "double_format": "%+.12lg",
      "complex_format": "%+.12lg%+.12lg%c"
    }
  },
  "clock": {
    "timezone": "PST+8PDT",
    "starttime": "'2000-01-01 00:00:00'",
    "stoptime": "'2000-01-01 00:00:12'"
  },
  "modules": {
    "powerflow": {
      "enable_subsecond_models": true,
      "deltamode_timestep": "4.0 ms",
      "solver_method": "NR",
      "all_powerflow_delta": true,
      "inline_comments": {
        "enable_subsecond_models": "//Enables deltamode",
        "deltamode_timestep": "//Defines the expected timestep for deltamode",
        "solver_method": "//Newton-Raphson is the only solver that supports deltamode",
        "all_powerflow_delta": "//Set all of the powerflow objects to deltamode – instead of having to do “flags DELTAMODE;” everywhere"
      }
    },
    "tape": {}
  },
  "objects": {
    "meter": {
      "instances": [
        {
          "name": "RootNode",
          "phases": "ABCN",
          "bustype": "SWING",
          "nominal_voltage": 240.0
        }
      ]
    },
    "recorder": {
      "instances": [
        {
          "parent": "RootNode",
          "property": "voltage_A.real,voltage_A.imag,voltage_B.real,voltage_B.imag,voltage_C.real,voltage_C.imag",
          "interval": 1,
          "flags": "DELTAMODE",
          "file": "SwingVoltageTest.csv"
        },
        {
          "parent": "RandomLine",
          "flags": "DELTAMODE",
          "property": "power_out_A.real,power_out_A.imag,power_out_real",
          "interval": 1,
          "file": "line_power_out.csv",
          "outside_comments": [
            "//Just to pad the object count"
          ]
        },
        {
          "parent": "SPIM_a",
          "file": "spim_a_rotor_spd.csv",
          "interval": 1,
          "property": "rotor_speed,motor_status",
          "flags": "DELTAMODE"
        },
        {
          "parent": "RootNode",
          "file": "meaured_power_Main.csv",
          "interval": 1,
          "property": "measured_power_A.real,measured_power_A.imag,measured_power_B.real,measured_power_B.imag,measured_power_C.real,measured_power_C.imag",
          "flags": "DELTAMODE"
        }
      ]
    },
    "overhead_line": {
      "instances": [
        {
          "name": "RandomLine",
          "phases": "ABCN",
          "from": "RootNode",
          "to": "other_node",
          "length": 25,
          "configuration": "lc1001",
          "inside_comments": [
            "//to induction_motor;"
          ]
        }
      ]
    },
    "node": {
      "instances": [
        {
          "name": "other_node",
          "phases": "ABCN",
          "nominal_voltage": 240.0
        }
      ]
    },
    "line_spacing": {
      "instances": [
        {
          "name": "ls5001",
          "distance_AB": 2.5,
          "distance_AC": 7.0,
          "distance_BC": 4.5,
          "distance_AN": 5.656854,
          "distance_BN": 4.272002,
          "distance_CN": 5.0,
          "outside_comments": [
            "//Arbitrary line - stolen from some other file"
          ]
        }
      ]
    },
    "line_configuration": {
      "instances": [
        {
          "name": "lc1001",
          "conductor_A": "olc10001",
          "conductor_B": "olc10001",
          "conductor_C": "olc10001",
          "conductor_N": "olc10002",
          "spacing": "ls5001"
        }
      ]
    },
    "overhead_line_conductor": {
      "instances": [
        {
          "name": "olc10001",
          "geometric_mean_radius": 0.0244,
          "resistance": 0.306
        },
        {
          "name": "olc10002",
          "geometric_mean_radius": 0.00814,
          "resistance": 0.592
        }
      ]
    },
    "motor": {
      "instances": [
        {
          "name": "SPIM_a",
          "parent": "other_node",
          "phases": "AN",
          "frequency_measure_type": "PLL",
          "base_power": 1000.0,
          "motor_trip": true,
          "nominal_voltage": 240.0,
          "time_step_divider": 20,
          "outside_comments": [
            "// object motor {",
            "// name induction_motor;",
            "// phases \"ABCN\";",
            "// parent other_node;",
            "// nominal_voltage 240.0;",
            "// motor_status RUNNING;",
            "// motor_trip true;",
            "// // reconnect_time 100 s;",
            "// // trip_time 99.0;",
            "// // uv_relay_install INSTALLED;",
            "// // uv_relay_trip_time 0.02;",
            "// // uv_relay_trip_V 0.6;",
            "// //delta_mode_voltage_trigger 120;",
            "// motor_operation_type THREE-PHASE;",
            "// torque_usage_method SPEEDFOUR;",
            "// base_power 3000.0;",
            "// H 0.1;",
            "// time_step_divider 20;",
            "// }"
          ],
          "inside_comments": [
            "//reconnect_time 100 s;",
            "//trip_time 0.5;",
            "//uv_relay_install INSTALLED;",
            "//uv_relay_trip_time 0.02;",
            "//uv_relay_trip_V 0.6;"
          ]
        },
        {
          "name": "SPIM_b",
          "parent": "other_node",
          "phases": "BN",
          "frequency_measure_type": "PLL",
          "base_power": 1000.0,
          "motor_trip": true,
          "nominal_voltage": 240.0,
          "time_step_divider": 20,
          "inside_comments": [
            "//reconnect_time 100 s;",
            "//trip_time 0.5;",
            "//uv_relay_install INSTALLED;",
            "//uv_relay_trip_time 0.02;",
            "//uv_relay_trip_V 0.6;"
          ]
        },
        {
          "name": "SPIM_c",
          "parent": "other_node",
          "phases": "CN",
          "frequency_measure_type": "PLL",
          "base_power": 1000.0,
          "motor_trip": true,
          "nominal_voltage": 240.0,
          "time_step_divider": 20,
          "inside_comments": [
            "//reconnect_time 100 s;",
            "//trip_time 0.5;",
            "//uv_relay_install INSTALLED;",
            "//uv_relay_trip_time 0.02;",
            "//uv_relay_trip_V 0.6;"
          ]
        }
      ]
    },
    "player": {
      "instances": [
        {
          "name": "voltage_A_player",
          "parent": "RootNode",
          "file": "../data_voltage_phase_A_ramp_time_step_divider.csv",
          "property": "voltage_A",
          "flags": "DELTAMODE"
        },
        {
          "name": "voltage_B_player",
          "parent": "RootNode",
          "file": "../data_voltage_phase_B_ramp_time_step_divider.csv",
          "property": "voltage_B",
          "flags": "DELTAMODE"
        },
        {
          "name": "voltage_C_player",
          "parent": "RootNode",
          "file": "../data_voltage_phase_C_ramp_time_step_divider.csv",
          "property": "voltage_C",
          "flags": "DELTAMODE"
        }
      ]
    }
  }
}