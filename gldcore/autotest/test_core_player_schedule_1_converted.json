{
  "__preamble": {
    "comments": [
      "// test_core_player_schedule_1.glm makes sure an unparented player",
      "// can serve as a schedule and work with transforms. the schedule is used",
      "// in a house object"
    ]
  },
  "_directives": {
    "#set": {
      "minimum_timestep": "1;"
    }
  },
  "classes": {
    "player": [
      {
        "type": "double",
        "name": "value"
      }
    ]
  },
  "clock": {
    "timezone": "PST+8PDT",
    "starttime": "'2000-01-01 00:00:00'",
    "stoptime": "'2000-01-03 02:00:00'"
  },
  "modules": {
    "residential": {
      "implicit_enduses": "NONE"
    },
    "tape": {},
    "assert": {}
  },
  "objects": {
    "player": {
      "instances": [
        {
          "name": "cool_stp",
          "file": "../test_core_player_schedule_1.player",
          "loop": 2
        },
        {
          "parent": "double_assert_4",
          "property": "value",
          "file": "../test_core_player_schedule_2.player",
          "loop": 2
        }
      ]
    },
    "recorder": {
      "instances": [
        {
          "parent": "house_2",
          "property": "heating_setpoint",
          "file": "transform_check.csv",
          "interval": -1,
          "limit": 55
        }
      ]
    },
    "double_assert": {
      "instances": [
        {
          "name": "double_assert_4",
          "parent": "house_2",
          "target": "cooling_setpoint",
          "status": "ASSERT_TRUE",
          "within": 1e-06
        }
      ]
    },
    "house": {
      "instances": [
        {
          "name": "house_2",
          "heating_setpoint": 60,
          "cooling_setpoint": "cool_stp.value*1+3.572"
        }
      ]
    }
  }
}