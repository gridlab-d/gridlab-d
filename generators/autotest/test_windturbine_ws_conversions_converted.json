      "instances": [
        {
          "name": "double_assert_21",
          "parent": "windturb1",
          "target": "WSadj",
          "within": 0.01
        },
        {
          "name": "double_assert_26",
          "parent": "windturb2",
          "target": "WSadj",
          "within": 0.01
        },
        {
          "name": "double_assert_30",
          "parent": "windturb3",
          "target": "WSadj",
          "within": 0.01
        }
      ]
    },
    "multi_recorder": {
      "instances": [
        {
          "parent": "windturb1",
          "file": "test_wind_power_${PF}1.csv",
          "interval": 900,
          "property": "voltage_12, voltage_1N, voltage_2N, current_12, power_12,WSadj,Cp,TrplMtr1:measured_real_power,total_real_power"
