{
  "_directives": {
    "#define": {
      "PF": "FBS"
    },
    "#set": {
      "profiler": "1;",
      "double_format": "%+.12lg",
      "randomseed": "10;",
      "relax_naming_rules": "1;"
    }
  },
  "clock": {
    "timezone": "PST+8PDT",
    "timestamp": "'2009-01-01 00:00:00'",
    "stoptime": "'2009-01-05 00:00:00'"
  },
  "modules": {
    "climate": {},
    "generators": {},
    "powerflow": {
      "solver_method": "${PF}"
    },
    "tape": {},
    "assert": {}
  },
  "objects": {
    "climate": {
      "instances": [
        {
          "tmyfile": "../Standard_Weather.csv",
          "reader": "csvreader",
          "outside_comments": [
            "//#set savefile=\"test_my_turbine_${PF}.xml\""
          ]
        }
      ]
    },
    "csv_reader": {
      "instances": [
        {
          "name": "csvreader",
          "filename": "../Standard_Weather.csv"
        }
      ]
    },
