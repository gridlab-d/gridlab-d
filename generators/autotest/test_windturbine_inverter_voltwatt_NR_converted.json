{
    "_directives": {
        "#define": {
            "PF": "NR"
        },
        "#set": {
            "profiler": "1;",
            "double_format": "%+.12lg",
            "randomseed": "10;",
            "relax_naming_rules": "1;"
        }
    },
    "clock": {
        "timezone": "PST+8PDT",
        "timestamp": "'2009-01-01 00:00:00'",
        "stoptime": "'2009-01-05 00:00:00'"
    },
    "modules": {
        "climate": {},
        "generators": {},
        "powerflow": {
            "solver_method": "${PF}"
        },
        "tape": {},
        "assert": {}
    },
    "objects": {
        "climate": {
            "instances": [
                {
                    "tmyfile": "../Standard_Weather.csv",
                    "reader": "csvreader",
                    "outside_comments": [
                        "//#set savefile=\"test_my_turbine_${PF}.xml\""
                    ]
                }
            ]
        },
        "csv_reader": {
            "instances": [
                {
                    "name": "csvreader",
                    "filename": "../Standard_Weather.csv"
                }
            ]
        },
        "overhead_line_conductor": {
            "instances": [
                {
                    "name": "olc100",
                    "object_declaration": "overhead_line_conductor:100",
                    "geometric_mean_radius": 0.0244,
                    "resistance": 0.306
                },
                {
                    "name": "olc101",
                    "geometric_mean_radius": 0.00814,
                    "resistance": 0.592
                }
            ]
        },
        "line_spacing": {
            "instances": [
                {
                    "name": "ls200",
                    "distance_AB": 2.5,
                    "distance_BC": 4.5,
                    "distance_AC": 7.0,
                    "distance_AN": 5.656854,
                    "distance_BN": 4.272002,
                    "distance_CN": 5.0
                }
            ]
        },
        "line_configuration": {
            "instances": [
                {
                    "name": "lc300",
                    "conductor_A": "olc100",
                    "conductor_B": "olc100",
                    "conductor_C": "olc100",
                    "conductor_N": "olc101",
                    "spacing": "ls200"
                }
            ]
        },
        "transformer_configuration": {
            "instances": [
                {
                    "name": "tc400",
                    "connect_type": "WYE_WYE",
                    "power_rating": 6000,
                    "primary_voltage": 12470,
                    "secondary_voltage": 4160,
                    "resistance": 0.01,
                    "reactance": 0.06,
                    "install_type": "PADMOUNT"
                },
                {
                    "name": "tc500",
                    "connect_type": "WYE_WYE",
                    "power_rating": 3000,
                    "primary_voltage": 4160,
                    "secondary_voltage": 600,
                    "resistance": 0.01,
                    "reactance": 0.06,
                    "install_type": "PADMOUNT",
                    "outside_comments": [
                        "// Add Vestas wind turbine"
                    ]
                },
                {
                    "object_declaration": "transformer_configuration:600",
                    "connect_type": "WYE_WYE",
                    "power_rating": 3000,
                    "primary_voltage": 4160,
                    "secondary_voltage": 690,
                    "resistance": 0.01,
                    "reactance": 0.06,
                    "install_type": "PADMOUNT",
                    "outside_comments": [
                        "// Add GE wind turbine"
                    ]
                }
            ]
        },
        "node": {
            "instances": [
                {
                    "name": "node1",
                    "phases": "ABCN",
                    "bustype": "SWING",
                    "voltage_A": "+7199.558+0.000j",
                    "voltage_B": "-3599.779-6235.000j",
                    "voltage_C": "-3599.779+6235.000j",
                    "nominal_voltage": 7200
                },
                {
                    "name": "node2",
                    "phases": "ABCN",
                    "voltage_A": "+7199.558+0.000j",
                    "voltage_B": "-3599.779-6235.000j",
                    "voltage_C": "-3599.779+6235.000j",
                    "nominal_voltage": 7200
                },
                {
                    "name": "node3",
                    "phases": "ABCN",
                    "voltage_A": "+2401.777+0.000j",
                    "voltage_B": "-1200.889-2080.000j",
                    "voltage_C": "-1200.889+2080.000j",
                    "nominal_voltage": 2400
                }
            ]
        },
        "overhead_line": {
            "instances": [
                {
                    "name": "ohl12",
                    "phases": "ABCN",
                    "from": "node1",
                    "to": "node2",
                    "length": 2000,
                    "configuration": "lc300"
                },
                {
                    "name": "ohl34",
                    "phases": "ABCN",
                    "from": "node3",
                    "to": "load4",
                    "length": 2500,
                    "configuration": "lc300"
                }
            ]
        },
        "player": {
            "instances": [
                {
                    "parent": "double_assert_12",
                    "property": "value",
                    "file": "../windpower_assert_inv_NR.player"
                }
            ]
        },
        "double_assert": {
            "instances": [
                {
                    "name": "double_assert_12",
                    "parent": "xform23",
                    "target": "power_out_real",
                    "within": 5000,
                    "inside_comments": [
                        "// Solutions were determined from NR"
                    ]
                }
            ]
        },
        "recorder": {
            "instances": [
                {
                    "parent": "xform23",
                    "property": "power_out_real",
                    "interval": 900,
                    "file": "test_windpower_${PF}.csv"
                },
                {
                    "parent": "inv1",
                    "property": "V_In, I_In, VA_Out,phaseA_V_Out, phaseB_V_Out, phaseC_V_Out,power_A, power_B, power_C, phases",
                    "file": "TEST_inverter.csv",
                    "interval": 900
                }
            ]
        },
        "transformer": {
            "instances": [
                {
                    "name": "xform23",
                    "phases": "ABCN",
                    "from": "node2",
                    "to": "node3",
                    "configuration": "tc400"
                },
                {
                    "name": "l4tomymeter",
                    "phases": "ABCN",
                    "from": "load4",
                    "to": "my_meter1",
                    "configuration": "tc500"
                },
                {
                    "phases": "ABCN",
                    "from": "load4",
                    "to": "my_meter2",
                    "configuration": "transformer_configuration:600"
                }
            ]
        },
        "load": {
            "instances": [
                {
                    "name": "load4",
                    "phases": "ABCN",
                    "voltage_A": "+2401.777+0.000j",
                    "voltage_B": "-1200.889-2080.000j",
                    "voltage_C": "-1200.889+2080.000j",
                    "constant_power_A": "+1275000.000+790174.031j",
                    "constant_power_B": "+1800000.000+871779.789j",
                    "constant_power_C": "+2375000.000+780624.750j",
                    "maximum_voltage_error": 0.001,
                    "nominal_voltage": 2400
                }
            ]
        },
        "meter": {
            "instances": [
                {
                    "name": "my_meter1",
                    "phases": "ABCN",
                    "nominal_voltage": 350
                },
                {
                    "name": "my_meter2",
                    "phases": "ABCN",
                    "nominal_voltage": 400
                }
            ]
        },
        "multi_recorder": {
            "instances": [
                {
                    "parent": "windturb1",
                    "file": "test_wind_power_${PF}1.csv",
                    "interval": 900,
                    "property": "wind_speed,WSadj,Cp,my_meter1:measured_real_power,total_real_power"
                },
                {
                    "parent": "windturb2",
                    "file": "test_wind_power_${PF}2.csv",
                    "interval": 900,
                    "property": "wind_speed,WSadj,Cp,my_meter2:measured_real_power,total_real_power"
                }
            ]
        },
        "windturb_dg": {
            "instances": [
                {
                    "name": "windturb1",
                    "parent": "my_meter1",
                    "phases": "ABCN",
                    "Gen_status": "ONLINE",
                    "Gen_type": "SYNCHRONOUS",
                    "Gen_mode": "CONSTANTP",
                    "Turbine_Model": "VESTAS_V82"
                },
                {
                    "name": "windturb2",
                    "parent": "inv1",
                    "phases": "ABCN",
                    "inside_comments": [
                        "//Gen_status ONLINE;",
                        "//Gen_type SYNCHRONOUS;",
                        "//Gen_mode CONSTANTP;",
                        "//Turbine_Model GE_25MW;"
                    ]
                }
            ]
        },
        "inverter": {
            "instances": [
                {
                    "name": "inv1",
                    "phases": "ABCN",
                    "parent": "my_meter2",
                    "rated_power": "50 kVA",
                    "inverter_efficiency": 1,
                    "inverter_type": "FOUR_QUADRANT",
                    "four_quadrant_control_mode": "VOLT_WATT",
                    "V_base": 400,
                    "V1": 0.9,
                    "Q1": 0.7,
                    "V2": 0.95,
                    "Q2": 0.0,
                    "V3": 1.05,
                    "Q3": 0.0,
                    "V4": 1.1,
                    "Q4": -0.8,
                    "generator_mode": "CONSTANT_PF",
                    "power_factor": 1,
                    "inside_comments": [
                        "//volt_var_control_lockout 0.5;",
                        "//generator_status ONLINE; //DEFAULT",
                        "//inverter_type PWM; //DEFAULT"
                    ],
                    "inline_comments": {
                        "rated_power": "// per phase;",
                        "generator_mode": "//DEFAULT"
                    }
                }
            ]
        }
    }
}