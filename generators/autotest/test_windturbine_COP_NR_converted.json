        "player": {
            "instances": [
                {
                    "parent": "double_assert_12",
                    "property": "value",
                    "file": "../windpower_assert.player"
                }
            ]
        },
        "double_assert": {
            "instances": [
                {
                    "name": "double_assert_12",
                    "parent": "transformer23",
                    "target": "power_out_real",
                    "within": 5000,
                    "inside_comments": [
                        "// Solutions were determined from FBS - represents",
                        "//  less than a 0.1% difference between the answers"
                    ]
                }
            ]
        },
        "recorder": {
            "instances": [
                {
                    "parent": "transformer23",
                    "property": "power_out_real",
                    "interval": 900,
                    "file": "test_windpower_${PF}.csv"
                }
            ]
        },
        "transformer": {
            "instances": [
                {
                    "name": "transformer23",
                    "object_declaration": "transformer:23",
                    "phases": "ABCN",
                    "from": "node:2",
                    "to": "node:3",
                    "configuration": "transformer_configuration:400"
                },
                {
                    "phases": "ABCN",
                    "from": "load:4",
                    "to": "my_meter1",
                    "configuration": "transformer_configuration:500"
                },
                {
                    "phases": "ABCN",
                    "from": "load:4",
                    "to": "my_meter2",
                    "configuration": "transformer_configuration:600"
                }
            ]
        },
        "load": {
            "instances": [
                {
                    "object_declaration": "load:4",
                    "phases": "ABCN",
                    "voltage_A": "+2401.777+0.000j",
