{
  "__preamble": {
    "comments": [
      "// Verifying the solar panel has the right parent. If the solar pannel has a parent, it should be an inverter. Otherwise and error is thrown.",
      "// This test assumes the soalr panel parent is a transformer, and therfore an error message shold be thrown.",
      "//#set threadcount=1;"
    ]
  },
  "_directives": {
    "#set": {
      "profiler": 1,
      "relax_naming_rules": 1
    }
  },
  "clock": {
    "timezone": "PST+8PDT",
    "timestamp": "'2010-01-01 6:00:00'",
    "stoptime": "'2010-01-01 12:00:00'"
  },
  "modules": {
    "climate": {},
    "generators": {},
    "powerflow": {
      "solver_method": "NR",
      "default_maximum_voltage_error": 1e-09,
      "inside_comments": [
        "//acceleration_factor 1.4;"
      ]
    },
    "residential": {},
    "tape": {},
    "assert": {}
  },
  "objects": {
    "recorder": {
      "instances": [
        {
          "parent": "MyClimate",
          "file": "climate_out.csv",
          "interval": 3600,
          "limit": 120,
          "property": "temperature,solar_global,solar_direct"
        }
      ]
    },
    "climate": {
      "instances": [
        {
          "name": "MyClimate",
          "tmyfile": "../WA-Seattle.tmy2",
          "inside_comments": [
            "//reader CsvReader;"
          ]
        }
      ]
    },
    "transformer_configuration": {
      "instances": [
        {
          "name": "trans_config_to_feeder",
          "connect_type": "WYE_WYE",
          "install_type": "PADMOUNT",
          "primary_voltage": 33000,
          "secondary_voltage": 2401.777,
          "power_rating": "5 MVA",
          "impedance": "0.00033+0.0022j",
          "outside_comments": [
            "// Create node objects"
          ]
        },
        {
          "name": "SPCT_trans",
          "connect_type": "SINGLE_PHASE_CENTER_TAPPED",
          "install_type": "POLETOP",
          "shunt_impedance": "10000+10000j",
          "primary_voltage": 2401.777,
          "secondary_voltage": 120,
          "powerB_rating": "110 kVA",
          "impedance": "0.00033+0.0022j"
        }
      ]
    },
    "node": {
      "instances": [
        {
          "name": "network_node",
          "bustype": "SWING",
          "nominal_voltage": 33000,
          "phases": "ABCN"
        },
        {
          "name": "645",
          "phases": "ABCN",
          "voltage_A": 2401.7771,
          "voltage_B": "-1200.8886-2080.000j",
          "voltage_C": "-1200.8886+2080.000j",
          "nominal_voltage": 2401.7771
        }
      ]
    },
    "transformer": {
      "instances": [
        {
          "name": "substation_transformer",
          "from": "network_node",
          "to": "645",
          "phases": "ABCN",
          "configuration": "trans_config_to_feeder"
        },
        {
          "name": "CTTF_B_645",
          "phases": "BS",
          "from": "645",
          "to": "tn_B_645",
          "configuration": "SPCT_trans"
        }
      ]
    },
    "solar": {
      "instances": [
        {
          "name": "sol_inv_B_2_645",
          "parent": "CTTF_B_645",
          "generator_mode": "SUPPLY_DRIVEN",
          "panel_type": "SINGLE_CRYSTAL_SILICON",
          "V_Max": 79.34,
          "Voc": 91.22,
          "Voc_Max": 91.22,
          "efficiency": 0.2,
          "area": 450,
          "inline_comments": {
            "V_Max": "// max. power voltage (Vmp) from GE solar cell performance charatcetristics",
            "Voc": "//taken from GEPVp-200-M-Module performance characteristics, converted to degF",
            "Voc_Max": "//taken from GEPVp-200-M-Module performance characteristics,  converted to degF"
          }
        }
      ]
    },
    "inverter": {
      "instances": [
        {
          "name": "inv_B_2_645",
          "parent": "tn_B_645",
          "phases": "BS",
          "generator_mode": "CONSTANT_PF",
          "generator_status": "ONLINE",
          "inverter_type": "PWM",
          "power_factor": 1.0,
          "rated_power": 7560
        }
      ]
    },
    "triplex_meter": {
      "instances": [
        {
          "name": "tn_B_645",
          "phases": "BS",
          "nominal_voltage": 120,
          "groupid": "House_Meter"
        }
      ]
    }
  }
}