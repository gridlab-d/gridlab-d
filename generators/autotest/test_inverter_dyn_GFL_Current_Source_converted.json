{
  "__preamble": {
    "comments": [
      "// Autotest to test the functionality of the",
      "// Grid-following inverter, implemented as a current-source device",
      "//#set profiler=1",
      "//#set pauseatexit=1",
      "//Deltamode declarations - global values",
      "//#set deltamode_forced_always=true"
    ]
