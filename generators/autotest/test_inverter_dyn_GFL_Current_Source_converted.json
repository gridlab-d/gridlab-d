      "double_format": "%+.12lg",
      "complex_format": "%+.12lg%+.12lg%c",
      "deltamode_timestep": "100000000  //100 ms",
      "deltamode_maximumtime": "60000000000 //1 minute",
      "deltamode_iteration_limit": "10  //Iteration limit"
    }
  },
