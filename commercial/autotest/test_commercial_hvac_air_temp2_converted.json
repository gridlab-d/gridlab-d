{
  "__preamble": {
    "comments": [
      "// validates proper functioning of hvac by making sure inside air_temperature stays",
      "// within the thermostat setpoints; setpoints are 70/73 with 1 degF deadband; initial temperature",
      "// is 70 degF",
      "// payroll: d3y332"
    ]
  },
  "clock": {
    "timestamp": "'2000-01-01 0:00:00'",
    "stoptime": "'2000-02-01 0:00:00'",
    "timezone": "PST+8PDT"
  },
  "modules": {
    "commercial": {},
    "tape": {},
    "assert": {}
  },
  "objects": {
    "double_assert": {
      "instances": [
        {
          "parent": "office_1",
          "target": "air_temperature",
          "within": 4,
          "value": 71.5
        }
      ]
    },
    "recorder": {
      "instances": [
        {
          "parent": "office_1",
          "file": "commercial_hvac_usage.csv",
          "interval": 3600,
          "limit": 360,
          "property": "air_temperature,mass_temperature,hvac_mode"
        }
      ]
    },
    "office": {
      "instances": [
        {
          "name": "office_1",
          "floor_area": "4000 sf",
          "floor_height": "9 ft",
          "exterior_ua": 2.0,
          "interior_ua": 2.0,
          "interior_mass": 2000,
          "hvac.cooling.cop": -3,
          "hvac.heating.cop": 1.25,
          "heating_setpoint": 70,
          "cooling_setpoint": 73,
          "thermostat_deadband": 1,
          "air_temperature": 70
        }
      ]
    }
  }
}