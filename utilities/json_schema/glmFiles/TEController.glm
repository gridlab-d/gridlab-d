// Add recorders here
object group_recorder
{
	name cooling_setpoint_recorder;
	interval 300;
	file cooling_setpoint.csv;
	property cooling_setpoint;
	group "class=house";
}

object group_recorder{
	name controller_recorder;
	interval 300;
	file clearing_price.csv;
	property current_market.clearing_price;
	group "class=auction";
}