// Deterministic multi-window deltamode fixture for scenario matrix
#set dateformat=US

clock {
    timezone PST+8PDT;
    starttime '2020-01-01 00:00:00';
    stoptime '2020-01-01 00:00:30';
}

module powerflow;
module generators {
    enable_subsecond_models TRUE;
    deltamode_timestep 2000000; // 2 ms
}
module tape;

object meter {
    name dm_meter_multi;
    phases ABC;
    nominal_voltage 240;

    object player {
        file ../deltamode_multi_windows.csv;
        property voltage_A;
        flags DELTAMODE;
    };
}
