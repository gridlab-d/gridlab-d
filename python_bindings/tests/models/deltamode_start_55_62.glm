// Start-at-5.5 deltamode fixture for step()-only scenarios 4/5/6
#set dateformat=US

clock {
    timezone PST+8PDT;
    starttime '2020-01-01 00:00:05';
    stoptime '2020-01-01 00:00:20';
}

module powerflow;
module generators {
    enable_subsecond_models TRUE;
    deltamode_timestep 2000000; // 2 ms
}
module tape;

object meter {
    name dm_meter_start_55;
    phases ABC;
    nominal_voltage 240;

    object player {
        file ../deltamode_start_55_62.csv;
        property voltage_A;
        flags DELTAMODE;
    };

    object recorder {
        file deltamode_start_55_62_recorder.csv;
        property voltage_A;
        flags DELTAMODE;
    };
}
