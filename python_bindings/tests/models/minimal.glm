// Minimal GridLAB-D model for unit testing
// Single clock object, runs for 1 hour

clock {
    timezone PST+8PDT;
    starttime '2020-01-01 00:00:00';
    stoptime '2020-01-01 01:00:00';
}

module tape;
module residential;

object house {
    name test_house;
    floor_area 2000 sf;
    heating_setpoint 70 degF;
    cooling_setpoint 75 degF;
}
