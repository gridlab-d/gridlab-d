// Simple test model for Python bindings
clock {
    timezone PST+8PDT;
    starttime '2000-01-01 0:00:00';
    stoptime '2000-01-02 0:00:00';
}

module tape;
module residential;

object house {
    name test_house;
    floor_area 2000 sf;
    air_temperature 72 degF;
}

object recorder {
    parent test_house;
    property air_temperature;
    file test_output.csv;
    interval 3600;
}
