clock {
     timezone EST+5EDT;
     starttime '2000-01-01 00:00:00';
     stoptime '2000-01-16 00:00:00';
}
#include "appliance_schedules.glm";
#include "water_and_setpoint_schedule_v5.glm";
//#define stylesheet=http://gridlab-d.svn.sourceforge.net/viewvc/gridlab-d/trunk/core/gridlabd-2_0
#set minimum_timestep=1;
#set profiler=1;
#set relax_naming_rules=1;
#set double_format=%+.12lg

module tape;
module climate;
module residential {
     implicit_enduses NONE;
};
module powerflow {
    solver_method NR;
    NR_iteration_limit 50;
};
//module powerflow {
//    solver_method FBS;
//};
class player {
     double value;
};

object climate {
	interpolate QUADRATIC;
	name "OH-Cleveland";
	tmyfile "OH-Cleveland.tmy2";
};

//Fault check option
object fault_check {
	name base_fault_check_object;
	check_mode ONCHANGE;
	strictly_radial false;
//	eventgen_object testgendev;
	grid_association true;	//Flag to ensure non-monolithic islands
}

