clock {
  timezone PST+8PDT;
  timestamp '2023-07-01 00:00:00';
  stoptime '2023-07-01 01:00:00';
}

#set profiler=1
#set iteration_limit=100000;
#set relax_naming_rules=1;


#include "water_and_setpoint_schedule_v5.glm";
#include "appliance_schedules.glm";


module tape;
module climate;
object climate {
     name "WA-Pasco";
     tmyfile "WA-Pasco.tmy3";
     interpolate QUADRATIC;
};

module generators;
module powerflow {
  solver_method NR;
}
module residential {
  implicit_enduses NONE;
}

object regulator_configuration {     
      name regulator_configuration_3887;     
      name feeder_reg_cfg;     
      Control OUTPUT_VOLTAGE;     
      band_center 7900.0;     
      band_width 133;     
      connect_type WYE_WYE;     
      time_delay 30;     
      raise_taps 16;     
      lower_taps 16;     
      regulation 0.10;     
      tap_pos_A 0;     
      tap_pos_B 0;     
      tap_pos_C 0;     
}   
object transformer_configuration {
     name trans_config_to_feeder;
     connect_type WYE_WYE;
     install_type PADMOUNT;
     primary_voltage 230000;
     secondary_voltage 13800.000;
     power_rating 6.4 MVA;
     impedance 0.00033+0.0022j;
}  
