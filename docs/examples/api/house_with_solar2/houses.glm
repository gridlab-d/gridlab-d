// Feeder
object meter {
     name network_node;
     bustype SWING;
     nominal_voltage 727488;
     voltage_A 140320.608000+30d;
     voltage_B 142052.646000-90d;
     voltage_C 141681.840000+150d;
     phases ABCN;
}
object transformer {
     name substation_transformer;
     from network_node;
     to R4-12-47-1_node_572;
     phases ABCN;
     configuration trans_config_to_feeder;
}
object node {     
      name R4-12-47-1_node_572;     
      phases ABCN;     
      nominal_voltage 7967.43;     
      voltage_A 7967.43+0.0j;     
      voltage_B -3983.72-6900j;     
      voltage_C -3983.72+6900j;     
}  
