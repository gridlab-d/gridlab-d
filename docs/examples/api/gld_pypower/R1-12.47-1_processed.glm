clock {
     timezone EST+5EDT;
  timestamp '2010-06-01 00:00:00';
  stoptime '2010-06-01 00:01:00';
}
#set profiler=1
module tape;
module powerflow{
     solver_method NR;
      default_maximum_voltage_error 1e-6;
};
#ifdef WANT_VI_DUMP
#endif
module climate;
module generators;
module connection;
module residential {
  implicit_enduses NONE;
};
#include "appliance_schedules.glm";
#include "water_and_setpoint_schedule_v5.glm";
#include "commercial_schedules.glm";
#set minimum_timestep=5;
#set relax_naming_rules=1;
#set warn=0;

// The following module and object declaration is required for HELICS
module connection;
#ifdef USE_HELICS
object helics_msg {
  name GLD;
  configure gridlabd_config.json;
}
#endif

object metrics_collector_writer {
  interval 300;
  interim 43200;
  filename ${METRICS_FILE};
  // filename R1-12.47-1_processed_metrics.json;
};
object climate {
  name localWeather;
  interpolate QUADRATIC;
  latitude 30.0;
  longitude -110.0;
};
// default IEEE 1547-2018 settings for Category B
#define INV_VBASE=240.0
#define INV_V1=0.92
#define INV_V2=0.98
#define INV_V3=1.02
#define INV_V4=1.08
#define INV_Q1=0.44
#define INV_Q2=0.00
#define INV_Q3=0.00
#define INV_Q4=-0.44
#define INV_VIN=200.0
#define INV_IIN=32.5
#define INV_VVLOCKOUT=300.0
#define INV_VW_V1=1.05 // 1.05833
#define INV_VW_V2=1.10
#define INV_VW_P1=1.0
#define INV_VW_P2=0.0
#ifdef WANT_VI_DUMP
object voltdump {
  filename Voltage_Dump_R1-12.47-1_processed.csv;
  mode polar;
}
object currdump {
  filename Current_Dump_R1-12.47-1_processed.csv;
  mode polar;
}
#endif // &&& end of common section for combining TESP cases
// solar inverter mode on this feeder
#define INVERTER_MODE=CONSTANT_PF
object transformer_configuration {
  name XF1_PADMOUNT_AS_10;
  power_rating 10.00;
  powerA_rating 10.00;
  powerB_rating 0.0;
  powerC_rating 0.0;
  install_type PADMOUNT;
  connect_type SINGLE_PHASE_CENTER_TAPPED;
  primary_voltage 7200.0;
  secondary_voltage 120.0;
  resistance 0.00950;
