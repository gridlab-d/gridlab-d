object transformer_configuration {
     name trans_config_to_feeder;
     connect_type WYE_WYE;
     install_type PADMOUNT;
     primary_voltage 230000;
     secondary_voltage 12500.000;
     power_rating 8.4 MVA;
     impedance 0.00033+0.0022j;
}

//Start actual feeder

object meter {
     name network_node;
     bustype SWING;
     nominal_voltage 230000;
     object player {
          property voltage_A;
          loop 100;
          file V_A.player;
     };
     object player {
          property voltage_B;
          loop 100;
          file V_B.player;
     };
     object player {
          property voltage_C;
          loop 100;
          file V_C.player;
     };
     phases ABCN;
}

object transformer {
     name substation_transformer;
     from network_node;
     to R1-12-47-1_node_617;
     phases ABCN;
     configuration trans_config_to_feeder;
}

        
object regulator {     
      name R1-12-47-1_reg_1;     
      from R1-12-47-1_node_617;     
      to R1-12-47-1_meter_21;     
      phases ABCN;     
      configuration feeder_reg_cfg;     
}       
