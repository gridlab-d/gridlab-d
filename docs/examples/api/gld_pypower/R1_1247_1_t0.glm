object recorder {
     file R1_1247_1_t0_transformer_power.csv;
     parent substation_transformer;
     interval 900;
     limit 702720;
     property power_out_A.real,power_out_A.imag,power_out_B.real,power_out_B.imag,power_out_C.real,power_out_C.imag,power_out.real,power_out.imag,power_losses_A.real,power_losses_A.imag,power_losses_B.real,power_losses_B.imag,power_losses_C.real,power_losses_C.imag;
}

object collector {
     group "class=overhead_line";
     property sum(power_losses_A.real),sum(power_losses_A.imag),sum(power_losses_B.real),sum(power_losses_B.imag),sum(power_losses_C.real),sum(power_losses_C.imag);
     interval 900;
     limit 702720;
     file R1_1247_1_t0_OHL_losses.csv;
}

object collector {
     group "class=underground_line";
     property sum(power_losses_A.real),sum(power_losses_A.imag),sum(power_losses_B.real),sum(power_losses_B.imag),sum(power_losses_C.real),sum(power_losses_C.imag);
     interval 900;
     limit 702720;
     file R1_1247_1_t0_UGL_losses.csv;
}

object collector {
     group "class=triplex_line";
     property sum(power_losses_A.real),sum(power_losses_A.imag),sum(power_losses_B.real),sum(power_losses_B.imag),sum(power_losses_C.real),sum(power_losses_C.imag);
     interval 900;
     limit 702720;
     file R1_1247_1_t0_TPL_losses.csv;
}

object collector {
     group "class=transformer";
     property sum(power_losses_A.real),sum(power_losses_A.imag),sum(power_losses_B.real),sum(power_losses_B.imag),sum(power_losses_C.real),sum(power_losses_C.imag);
     interval 900;
     limit 702720;
     file R1_1247_1_t0_TFR_losses.csv;
}

object collector {
     group "class=house AND groupid=Residential";
     property avg(cooling_setpoint),avg(heating_setpoint,avg(air_temperature),sum(is_AUX_on),sum(is_HEAT_on),sum(is_COOL_on));
     interval 900;
     limit 702720;
     file R1_1247_1_t0_res_setpoints.csv;
}

object collector {
     group "class=triplex_meter AND groupid=Residential_Meter";
     property sum(measured_real_power),sum(indiv_measured_power_1.real),sum(indiv_measured_power_2.real);
     interval 900;
     limit 702720;
     file R1_1247_1_t0_res_load.csv;
}

