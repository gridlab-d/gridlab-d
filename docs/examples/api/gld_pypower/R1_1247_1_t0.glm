//Input feeder information for Taxonomy Feeders with different cases.
//Started on 10/21/09. This version created 01-May-2018 13:18:38.
// This version was created to perform FY11 Department of Energy
// analysis on the benefits of the SGIG grant projects.

clock {
     timezone PST+8PDT;
     starttime '2009-01-01 00:00:00';
     stoptime '2009-01-02 00:00:00';
}

#include "appliance_schedules.glm";
#include "water_and_setpoint_schedule_v5.glm";
//#define stylesheet=http://gridlab-d.svn.sourceforge.net/viewvc/gridlab-d/trunk/core/gridlabd-2_0
#set minimum_timestep=60;
#set profiler=1;
#set relax_naming_rules=1;

module tape;
module climate;
module residential {
     implicit_enduses NONE;
};
module powerflow {
     solver_method NR;
     NR_iteration_limit 50;
     lu_solver "KLU_x64";
};

class player {
     double value;
};

object climate {
     name "CA-San_francisco";
     tmyfile "CA-San_francisco.tmy2";
     interpolate QUADRATIC;
};

//Configurations

object regulator_configuration {     
      name regulator_configuration_4384;     
      name feeder_reg_cfg;     
      Control OUTPUT_VOLTAGE;     
      band_center 7520.0;     
      band_width 120;     
      connect_type WYE_WYE;     
      time_delay 30;     
      raise_taps 16;     
      lower_taps 16;     
      regulation 0.10;     
      tap_pos_A 0;     
      tap_pos_B 0;     
      tap_pos_C 0;     
}       

