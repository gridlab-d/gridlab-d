           impedance_pf 1.000;
           impedance_fraction 0.200000;
           current_fraction 0.400000;
           power_fraction 0.400000;
     };
     object ZIPload {
           // Unresponsive load
           schedule_skew -77;
           base_power unresponsive_loads*1.24;
           heatgain_fraction 0.900;
           power_pf 1.000;
           current_pf 1.000;
           impedance_pf 1.000;
           impedance_fraction 0.200000;
           current_fraction 0.400000;
           power_fraction 0.400000;
     };
     object waterheater {
          schedule_skew 11860;
          heating_element_capacity 4.5 kW;
          tank_setpoint 133.7;
          temperature 132;
          thermostat_deadband 7.0;
          location INSIDE;
          tank_UA 3.3;
          demand large_5*0.96;
          tank_volume 50;
     };

}

