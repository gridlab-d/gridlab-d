{
  "__preamble": {
    "comments": [
      "//This file tests that the appropriate variables",
      "//are set correctly when the market fails to clear",
      "//because there are no buyers",
      "//Bidding period: 3600 s",
      "//Seller1: bid 60, quantity: 5, period: 3600 s",
      "//Seller2: bid 42, quantity: 5, period: 3600 s",
      "//Seller3: bid 18, quantity: 5, period: 3600 s",
      "//Expected clearing price: 17.9999",
      "//Expected clearing quantity: 0",
      "//There are no buyers so clearing price will be",
      "//set 1 cent below the lowest seller bid"
    ]
  },
  "_directives": {
    "#define": {
      "stylesheet": "http://gridlab-d.svn.sourceforge.net/viewvc/gridlab-d/trunk/core/gridlabd-2_0"
    },
    "#set": {
      "tmp": "../test_markets_auction_no_buyers"
    }
  },
  "_legacy": {
    "#setenv": [
      "GRIDLABD=../../../core"
    ]
  },
  "classes": {
    "auction": [
      {
        "type": "double",
        "name": "current_price_mean_24h"
      },
      {
        "type": "double",
        "name": "current_price_stdev_24h"
      }
    ]
  },
  "clock": {
    "timezone": "PST+8PDT",
    "starttime": "'2001-01-01 00:00:00'",
    "stoptime": "'2001-01-03 00:00:00'"
  },
  "modules": {
    "market": {},
    "tape": {},
    "assert": {}
  },
  "objects": {
    "multi_recorder": {
      "instances": [
        {
          "parent": "Market_1",
          "property": "current_market.clearing_price,current_market.clearing_quantity,current_market.clearing_type,current_price_mean_24h,current_price_stdev_24h,seller1:price,seller1:quantity,seller2:price,seller2:quantity,seller3:price,seller3:quantity",
          "file": "test_markets_auction_no_buyers_output.csv",
          "interval": 3600,
          "limit": 168
        }
      ]
    },
    "double_assert": {
      "instances": [
        {
          "parent": "Market_1",
          "in": "'2001-01-01 01:00:00'",
          "value": 17.9999,
          "within": 0.0001,
          "target": "current_market.clearing_price"
        },
        {
          "parent": "Market_1",
          "in": "'2001-01-01 01:00:00'",
          "value": 0,
          "within": 1e-05,
          "target": "current_market.clearing_quantity"
        },
        {
          "parent": "Market_1",
          "value": 17.9999,
          "within": 0.0001,
          "target": "current_price_mean_24h"
        },
        {
          "parent": "Market_1",
          "value": 0,
          "within": 1e-05,
          "target": "current_price_stdev_24h"
        },
        {
          "parent": "Market_1",
          "value": 0,
          "target": "current_market.marginal_quantity",
          "within": 1e-05
        }
      ]
    },
    "enum_assert": {
      "instances": [
        {
          "parent": "Market_1",
          "in": "'2001-01-01 01:00:00'",
          "value": 0,
          "target": "current_market.clearing_type",
          "inline_comments": {
            "value": "//NULL type"
          }
        }
      ]
    },
    "auction": {
      "instances": [
        {
          "name": "Market_1",
          "unit": "MWh",
          "period": 3600,
          "verbose": true,
          "special_mode": "NONE",
          "warmup": 0,
          "init_price": 17.9999,
          "init_stdev": 1e-06
        }
      ]
    },
    "stub_bidder": {
      "instances": [
        {
          "name": "seller1",
          "role": "SELLER",
          "bid_period": 3600,
          "market": "Market_1",
          "price": 18,
          "quantity": 5,
          "count": 10000,
          "outside_comments": [
            "// object stub_bidder {",
            "// name buyer1;",
            "// role BUYER;",
            "// bid_period 3600;",
            "// market Market_1;",
            "// price 31;",
            "// quantity 5;",
            "// count 10000;",
            "// };",
            "// object stub_bidder {",
            "// name buyer2;",
            "// role BUYER;",
            "// bid_period 3600;",
            "// market Market_1;",
            "// price 47;",
            "// quantity 5;",
            "// count 10000;",
            "// }",
            "// object stub_bidder {",
            "// name buyer3;",
            "// role BUYER;",
            "// bid_period 3600;",
            "// market Market_1;",
            "// price 63;",
            "// quantity 5;",
            "// count 10000;",
            "// }"
          ]
        },
        {
          "name": "seller2",
          "role": "SELLER",
          "bid_period": 3600,
          "market": "Market_1",
          "price": 60,
          "quantity": 5,
          "count": 10000
        },
        {
          "name": "seller3",
          "role": "SELLER",
          "bid_period": 3600,
          "market": "Market_1",
          "price": 42,
          "quantity": 5,
          "count": 10000
        }
      ]
    }
  }
}