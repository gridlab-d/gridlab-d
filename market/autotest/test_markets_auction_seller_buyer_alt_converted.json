{
  "__preamble": {
    "comments": [
      "//This file tests that the clearing prices are valid when",
      "//the clearing quantities are equal and close to either the",
      "//next seller bid or the next buyer bid"
    ]
  },
  "_directives": {
    "#define": {
      "stylesheet": "http://gridlab-d.svn.sourceforge.net/viewvc/gridlab-d/trunk/core/gridlabd-2_0"
    },
    "#set": {
      "tmp": "../test_markets_auction_seller_buyer_alt"
    }
  },
  "_legacy": {
    "#setenv": [
      "GRIDLABD=../../../core"
    ]
  },
  "classes": {
    "auction": [
      {
        "type": "double",
        "name": "current_price_mean_24h"
      },
      {
        "type": "double",
        "name": "current_price_stdev_24h"
      }
    ]
  },
  "clock": {
    "timezone": "PST+8PDT",
    "starttime": "'2001-01-01 00:00:00'",
    "stoptime": "'2001-01-03 00:00:00'"
  },
  "modules": {
    "market": {},
    "tape": {},
    "assert": {}
  },
  "objects": {
    "multi_recorder": {
      "instances": [
        {
          "name": "multi_recorder_2",
          "parent": "Market_1",
          "property": "current_market.clearing_price,current_market.clearing_quantity,current_price_mean_24h,current_price_stdev_24h,buyer1:price,buyer1:quantity,buyer2:price,buyer2:quantity,buyer3:price,buyer3:quantity,seller1:price,seller1:quantity,seller2:price,seller2:quantity,seller3:price,seller3:quantity",
          "file": "test_markets_auction_seller_buyer_alt_output.csv",
          "interval": 3600,
          "limit": 168
        }
      ]
    },
    "double_assert": {
      "instances": [
        {
          "name": "double_assert_3",
          "parent": "Market_1",
          "in": "'2001-01-01 01:00:00'",
          "value": 25,
          "within": 1e-05,
          "target": "current_market.clearing_price"
        },
        {
          "name": "double_assert_4",
          "parent": "Market_1",
          "in": "'2001-01-01 01:00:00'",
          "value": 10,
          "within": 1e-05,
          "target": "current_market.clearing_quantity"
        },
        {
          "name": "double_assert_5",
          "parent": "Market_1",
          "value": 25,
          "within": 1e-05,
          "target": "current_price_mean_24h"
        },
        {
          "name": "double_assert_6",
          "parent": "Market_1",
          "value": 0,
          "within": 1e-05,
          "target": "current_price_stdev_24h"
        },
        {
          "name": "double_assert_8",
          "parent": "Market_1",
          "value": 0,
          "target": "current_market.marginal_quantity",
          "within": 1e-05
        }
      ]
    },
    "enum_assert": {
      "instances": [
        {
          "name": "enum_assert_7",
          "parent": "Market_1",
          "in": "'2001-01-01 01:00:00'",
          "value": 3,
          "target": "current_market.clearing_type"
        }
      ]
    },
    "auction": {
      "instances": [
        {
          "name": "Market_1",
          "unit": "MWh",
          "period": 3600,
          "verbose": true,
          "special_mode": "NONE",
