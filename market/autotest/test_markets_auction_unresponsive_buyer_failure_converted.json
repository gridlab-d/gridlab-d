{
  "__preamble": {
    "comments": [
      "//This file tests that the appropriate variables",
      "//are set correctly when the market fails to clear",
      "//because of unresponsive buyer demand",
      "//Bidding period: 3600 s",
      "//Buyer1: bid 9999, quantity: 50, period: 3600 s (unresponsive buyer)",
      "//Buyer2: bid 47, quantity: 5, period: 3600 s",
      "//Buyer3: bid 32, quantity: 5, period: 3600 s",
      "//Seller1: bid 70, quantity: 5, period: 3600 s",
      "//Seller2: bid 83, quantity: 5, period: 3600 s",
      "//Seller3: bid 97, quantity: 5, period: 3600 s",
      "//Expected clearing price: 9999",
      "//Expected clearing quantity: 15",
      "//The clearing type should be set to FAILURE"
    ]
  },
  "_directives": {
    "#define": {
      "stylesheet": "http://gridlab-d.svn.sourceforge.net/viewvc/gridlab-d/trunk/core/gridlabd-2_0"
    },
    "#set": {
      "tmp": "../test_markets_auction_unresponsive_buyer_failure"
    }
  },
  "_legacy": {
    "#setenv": [
      "GRIDLABD=../../../core"
    ]
  },
  "classes": {
    "auction": [
      {
        "type": "double",
        "name": "current_price_mean_24h"
      },
      {
        "type": "double",
        "name": "current_price_stdev_24h"
      }
    ]
  },
  "clock": {
    "timezone": "PST+8PDT",
    "starttime": "'2001-01-01 00:00:00'",
    "stoptime": "'2001-01-03 00:00:00'"
  },
  "modules": {
    "market": {},
    "tape": {},
    "assert": {}
  },
  "objects": {
    "multi_recorder": {
      "instances": [
        {
          "name": "multi_recorder_2",
          "parent": "Market_1",
          "property": "current_market.clearing_price,current_market.clearing_quantity,current_market.clearing_type,current_market.marginal_quantity,current_price_mean_24h,current_price_stdev_24h,buyer1:price,buyer1:quantity,buyer2:price,buyer2:quantity,buyer3:price,buyer3:quantity,seller1:price,seller1:quantity,seller2:price,seller2:quantity,seller3:price,seller3:quantity,price_cap",
          "file": "test_markets_auction_unresponsive_buyer_failure_output.csv",
          "interval": 3600,
          "limit": 168
        }
      ]
    },
    "double_assert": {
      "instances": [
        {
          "name": "double_assert_3",
          "parent": "Market_1",
          "in": "'2001-01-01 01:00:00'",
          "value": 9999,
          "within": 0.0001,
          "target": "current_market.clearing_price"
        },
        {
          "name": "double_assert_4",
          "parent": "Market_1",
          "in": "'2001-01-01 01:00:00'",
          "value": 15,
          "within": 1e-05,
          "target": "current_market.clearing_quantity"
        },
        {
          "name": "double_assert_5",
          "parent": "Market_1",
          "value": 9999,
          "within": 0.0001,
          "target": "current_price_mean_24h"
        },
        {
          "name": "double_assert_6",
          "parent": "Market_1",
          "value": 0,
          "within": 1e-05,
          "target": "current_price_stdev_24h"
        },
        {
          "name": "double_assert_8",
          "parent": "Market_1",
          "in": "'2001-01-01 01:00:00'",
          "value": 0,
          "target": "current_market.marginal_quantity",
          "within": 1e-05,
          "inline_comments": {
            "value": "//Consider infinite number of unresponsive buyers w/ infinitesimal demands"
          }
        },
        {
          "name": "double_assert_9",
          "parent": "Market_1",
          "in": "'2001-01-01 01:00:00'",
          "value": 15,
          "target": "current_market.seller_total_quantity",
          "within": 1e-05
        },
        {
          "name": "double_assert_10",
          "parent": "Market_1",
          "in": "'2001-01-01 01:00:00'",
          "value": 60,
          "target": "current_market.buyer_total_quantity",
          "within": 1e-05
        },
        {
          "name": "double_assert_11",
          "parent": "Market_1",
          "in": "'2001-01-01 01:00:00'",
          "value": 70,
          "target": "current_market.seller_min_price",
          "within": 1e-05
        }
      ]
    },
    "enum_assert": {
      "instances": [
        {
          "name": "enum_assert_7",
          "parent": "Market_1",
          "in": "'2001-01-01 01:00:00'",
          "value": 5,
          "target": "current_market.clearing_type",
          "inline_comments": {
            "value": "//Should be FAILURE, but is MARGINAL_BUYER instead - FIXED"
          }
        }
      ]
    },
    "auction": {
      "instances": [
        {
          "name": "Market_1",
          "unit": "MWh",
          "period": 3600,
          "verbose": true,
          "special_mode": "NONE",
          "warmup": 0,
          "init_price": 9999,
          "init_stdev": 1e-06,
          "price_cap": 9999
        }
      ]
    },
    "stub_bidder": {
      "instances": [
        {
          "name": "buyer1",
          "role": "BUYER",
          "bid_period": 3600,
          "market": "Market_1",
          "price": 9999,
          "quantity": 50,
          "count": 10000
        },
        {
          "name": "buyer2",
          "role": "BUYER",
          "bid_period": 3600,
          "market": "Market_1",
          "price": 32,
          "quantity": 5,
          "count": 10000
        },
        {
          "name": "buyer3",
          "role": "BUYER",
          "bid_period": 3600,
          "market": "Market_1",
          "price": 47,
          "quantity": 5,
          "count": 10000
        },
        {
          "name": "seller1",
          "role": "SELLER",
          "bid_period": 3600,
          "market": "Market_1",
          "price": 83,
          "quantity": 5,
          "count": 10000
        },
        {
          "name": "seller2",
          "role": "SELLER",
          "bid_period": 3600,
          "market": "Market_1",
          "price": 97,
          "quantity": 5,
          "count": 10000
        },
        {
          "name": "seller3",
          "role": "SELLER",
          "bid_period": 3600,
          "market": "Market_1",
          "price": 70,
          "quantity": 5,
          "count": 10000
        }
      ]
    }
  }
}