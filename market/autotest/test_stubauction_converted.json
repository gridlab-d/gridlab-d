{
  "_directives": {
    "#set": {
      "tmp": "../test_stubauction"
    }
  },
  "_legacy": {
    "#setenv": [
      "GRIDLABD=../../../core"
    ]
  },
  "clock": {
    "timezone": "CST+6CDT",
    "timestamp": "'2006-01-01 00:00:00'",
    "stoptime": "'2007-01-01 00:00:00'"
  },
  "modules": {
    "market": {},
    "tape": {},
    "assert": {}
  },
  "objects": {
    "player": {
      "instances": [
        {
          "parent": "STUB",
          "file": "../Price_Static.player",
          "loop": 10000000,
          "property": "next.P"
        },
        {
          "parent": "STUBassert_lastP",
          "property": "value",
          "file": "../lastP_static.player",
          "loop": 100000
        },
        {
          "parent": "STUB2",
          "file": "../Price_Changing.player",
          "loop": 10000000,
          "property": "next.P"
        },
        {
          "parent": "STUB2assert_nextP_2",
          "property": "value",
          "file": "../Price_Changing.player",
          "loop": 100000
        }
      ]
    },
    "recorder": {
      "instances": [
        {
          "parent": "STUB",
          "property": "avg24,std24,last.P,next.P",
          "limit": 8808,
          "interval": 300,
          "file": "Output.csv"
        },
        {
          "parent": "STUB2",
          "property": "avg24,std24,last.P,next.P",
          "limit": 8808,
          "interval": 300,
          "file": "Output_2.csv"
        }
      ]
    },
    "double_assert": {
      "instances": [
        {
          "name": "STUBassert_std24",
          "parent": "STUB",
          "target": "std24",
          "within": 0.0001,
          "value": 0.0
        },
        {
          "name": "STUBassert_lastP",
          "parent": "STUB",
          "target": "last.P",
          "within": 0.0001
        },
        {
          "name": "STUBassert_nextP",
          "parent": "STUB",
          "target": "next.P",
          "within": 0.0001,
          "value": 0.1
        },
        {
          "name": "STUB2assert_nextP_2",
          "parent": "STUB2",
          "target": "next.P",
          "within": 0.0001
        }
      ]
    },
    "stubauction": {
      "instances": [
        {
          "name": "STUB",
          "unit": "price",
          "period": 900,
          "inside_comments": [
            "// At this time, this assert fails because the rolling average is not calculated",
            "// using the defined period, but is locked into one hour updates.",
            "// object double_assert {",
            "// name assert_avg24;",
            "// target avg24;",
            "// within 0.0001;",
            "// object player {",
            "// property value;",
            "// file lastP_static.player;",
            "// loop 100000;",
            "// };",
            "// };"
          ]
        },
        {
          "name": "STUB2",
          "unit": "price",
          "period": 900,
          "inside_comments": [
            "// At this time, this assert fails because the rolling average is not calculated",
            "// using the defined period, but is locked into one hour updates.",
            "// object double_assert {",
            "// name assert_avg24_2;",
            "// target avg24;",
            "// within 0.0001;",
            "// object player {",
            "// property value;",
            "// file lastP_static.player;",
            "// loop 100000;",
            "// };",
            "// };",
            "// object double_assert {",
            "// name assert_std24_2;",
            "// target std24;",
            "// within 0.0001;",
            "// value 0.0;",
            "// };",
            "// object double_assert {",
            "// name assert_lastP_2;",
            "// target last.P;",
            "// within 0.0001;",
            "// object player {",
            "// property value;",
            "// file lastP_static.player;",
            "// loop 100000;",
            "// };",
            "// };"
          ]
        }
      ]
    }
  }
}