{
  "__preamble": {
    "comments": [
      "// Design a market to test the SELLERS_ONLY and BUYERS_ONLY special operation modes. Ensure the market automatically submits a",
      "// bid using the fixed_price or fixed_quantity parameters. Ensure the market clears to an appropriate value, including an",
      "// unresolvable condition (i.e., if the market can't clear, ensure it doesn't and returns appropriate outputs)."
    ]
  },
  "_directives": {
    "#set": {
      "tmp": "../test_market_auction_advanced_1"
    }
  },
  "_legacy": {
    "#setenv": [
      "GRIDLABD=../../../core"
    ]
  },
  "clock": {
    "timezone": "PST+8PDT",
    "starttime": "'2001-01-01 00:00:00'",
    "stoptime": "'2001-01-02 00:00:00'"
  },
  "modules": {
    "market": {},
    "tape": {},
    "assert": {}
  },
  "objects": {
    "double_assert": {
      "instances": [
        {
          "parent": "Market_1",
          "target": "current_market.clearing_price",
          "in": "'2001-01-01 1:00:00'",
          "status": "ASSERT_TRUE",
          "value": "cp1*1",
          "within": 1e-05
        },
        {
          "parent": "Market_1",
          "target": "current_market.clearing_quantity",
          "in": "'2001-01-01 1:00:00'",
          "status": "ASSERT_TRUE",
          "value": "cq1*1",
          "within": 0.001,
          "inline_comments": {
            "within": "// asserting clearing quantity"
          }
        },
        {
          "parent": "Market_2",
          "target": "current_market.clearing_price",
          "in": "'2001-01-01 1:00:00'",
          "status": "ASSERT_TRUE",
          "value": "cp2*1",
          "within": 1e-05
        },
        {
          "parent": "Market_2",
          "target": "current_market.clearing_quantity",
          "in": "'2001-01-01 1:00:00'",
          "status": "ASSERT_TRUE",
          "value": "cq2*1",
          "within": 0.001,
          "inline_comments": {
            "within": "// asserting clearing quantity"
          }
        },
        {
          "parent": "Market_3",
          "target": "current_market.clearing_price",
          "in": "'2001-01-01 1:00:00'",
          "status": "ASSERT_TRUE",
          "value": "cp3*1",
          "within": 1e-05
        },
        {
          "parent": "Market_3",
          "target": "current_market.clearing_quantity",
