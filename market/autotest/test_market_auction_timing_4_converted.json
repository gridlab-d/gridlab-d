{
  "__preamble": {
    "comments": [
      "// Design a market with unbalanced period and latency settings. Try setting the period larger than the",
      "// latency and vice-versa. Ensure the market clears at the correct interval and is becoming active at",
      "// the proper time. Ensure that highly delayed markets (latency much larger than the period) are",
      "// stored properly, and that the correct cleared market becomes active at the proper time. Also ensure the",
      "// past_market, current_market, and next_market quantities are being properly updated through these transitions.",
      "// Include tests of 0 latency (cleared market immediately becomes the current market)."
    ]
  },
  "_directives": {
    "#set": {
      "tmp": "../test_market_auction_timing_4"
    }
  },
  "_legacy": {
    "#setenv": [
      "GRIDLABD=../../../core"
    ]
  },
  "clock": {
    "timezone": "PST+8PDT",
    "starttime": "'2001-01-01 00:00:00'",
    "stoptime": "'2001-01-14 00:00:00'"
  },
  "modules": {
    "market": {},
    "tape": {},
    "assert": {}
  },
  "objects": {
    "recorder": {
      "instances": [
        {
          "name": "recorder_2",
          "parent": "Market_1",
          "property": "past_market.clearing_price,past_market.clearing_quantity,current_market.clearing_price,current_market.clearing_quantity,next_market.clearing_price,next_market.clearing_quantity",
          "file": "test_market_timing_4.csv",
          "interval": 3600,
          "limit": 10000
        }
      ]
    },
    "double_assert": {
      "instances": [
        {
          "name": "double_assert_3",
          "parent": "Market_1",
          "target": "next_market.clearing_price",
          "in": "'2001-01-08 06:00:00'",
          "out": "'2001-01-08 08:00:00'",
          "status": "ASSERT_TRUE",
          "value": 30,
          "within": 0.001,
          "inline_comments": {
            "within": "// asserting clearing price within 1 percent of result"
          }
        },
        {
          "name": "double_assert_4",
          "parent": "Market_1",
          "target": "current_market.clearing_price",
          "in": "'2001-01-08 07:00:00'",
          "out": "'2001-01-08 09:00:00'",
          "status": "ASSERT_TRUE",
          "value": 30,
          "within": 0.001,
          "inline_comments": {
            "within": "// asserting clearing price within 1 percent of result"
          }
        },
        {
          "name": "double_assert_5",
          "parent": "Market_1",
          "target": "past_market.clearing_price",
          "in": "'2001-01-08 08:00:00'",
          "out": "'2001-01-08 10:00:00'",
          "status": "ASSERT_TRUE",
          "value": 30,
          "within": 0.001,
          "inline_comments": {
            "within": "// asserting clearing price within 1 percent of result"
          }
        },
        {
          "name": "double_assert_6",
          "parent": "Market_1",
          "target": "next_market.clearing_quantity",
          "in": "'2001-01-08 06:00:00'",
          "out": "'2001-01-08 08:00:00'",
          "status": "ASSERT_TRUE",
          "value": 7,
          "within": 0.001,
          "inline_comments": {
            "within": "// asserting clearing price within 1 percent of result"
          }
        },
        {
          "name": "double_assert_7",
          "parent": "Market_1",
          "target": "current_market.clearing_quantity",
          "in": "'2001-01-08 07:00:00'",
          "out": "'2001-01-08 09:00:00'",
          "status": "ASSERT_TRUE",
          "value": 7,
          "within": 0.001,
          "inline_comments": {
            "within": "// asserting clearing price within 1 percent of result"
          }
        },
        {
          "name": "double_assert_8",
          "parent": "Market_1",
          "target": "past_market.clearing_quantity",
          "in": "'2001-01-08 08:00:00'",
          "out": "'2001-01-08 10:00:00'",
          "status": "ASSERT_TRUE",
          "value": 7,
          "within": 0.001,
          "inline_comments": {
            "within": "// asserting clearing price within 1 percent of result"
          }
        }
      ]
    },
    "auction": {
      "instances": [
        {
          "name": "Market_1",
          "latency": "1wk",
          "warmup": 0,
          "unit": "MWh",
          "period": 3600,
          "init_price": 0,
          "verbose": true,
          "special_mode": "NONE"
        }
      ]
    },
    "stub_bidder": {
      "instances": [
        {
          "name": "buyer_1",
          "role": "BUYER",
          "bid_period": 3600,
          "market": "Market_1",
          "price": "buyer_price*1",
          "quantity": "buyer_quantity*1",
          "count": 10000
        },
        {
          "name": "buyer_2",
          "role": "BUYER",
          "bid_period": 900,
          "market": "Market_1",
          "price": "buyer_price*3",
          "quantity": "buyer_quantity*1",
          "count": 10000
        },
        {
          "name": "buyer_3",
          "role": "BUYER",
          "bid_period": 300,
          "market": "Market_1",
          "price": "buyer_price*5",
          "quantity": "buyer_quantity*1",
          "count": 10000
        },
        {
          "name": "seller_1",
          "role": "SELLER",
          "bid_period": 3600,
          "market": "Market_1",
          "price": "seller_1_price*1",
          "quantity": "seller_quantity*1",
          "count": 10000
        },
        {
          "name": "seller_2",
          "role": "SELLER",
          "bid_period": 900,
          "market": "Market_1",
          "price": "seller_2_price*1",
          "quantity": "seller_quantity*1",
          "count": 10000
        },
        {
          "name": "seller_3",
          "role": "SELLER",
          "bid_period": 300,
          "market": "Market_1",
          "price": "seller_3_price*1",
          "quantity": "seller_quantity*1",
          "count": 10000
        }
      ]
    }
  },
  "schedules": {
    "buyer_price": [
      {
