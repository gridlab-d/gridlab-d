{
  "__preamble": {
    "comments": [
      "//This file tests that the clearing prices are valid when",
      "//the clearing quantities are equal and close to either the",
      "//next seller bid or the next buyer bid"
    ]
  },
  "_directives": {
    "#define": {
      "stylesheet": "http://gridlab-d.svn.sourceforge.net/viewvc/gridlab-d/trunk/core/gridlabd-2_0"
    },
    "#set": {
      "tmp": "../test_markets_auction_cases_4_and_5"
    }
  },
  "_legacy": {
    "#setenv": [
      "GRIDLABD=../../../core"
    ]
  },
  "classes": {
    "auction": [
      {
        "type": "double",
        "name": "current_price_mean_24h"
      },
      {
        "type": "double",
        "name": "current_price_stdev_24h"
      }
    ]
  },
  "clock": {
    "timezone": "PST+8PDT",
    "starttime": "'2001-01-01 00:00:00'",
    "stoptime": "'2001-01-03 00:00:00'"
  },
  "modules": {
    "market": {},
    "tape": {},
    "assert": {}
  },
  "objects": {
    "multi_recorder": {
      "instances": [
        {
          "name": "multi_recorder_2",
          "parent": "Market_1",
          "property": "current_market.clearing_price,current_market.clearing_quantity,buyer_1:price,buyer_1:quantity,buyer_2:price,buyer_2:quantity,seller_1:price,seller_1:quantity,seller_2:price,seller_2:quantity,current_price_mean_24h,current_price_stdev_24h",
          "file": "test_markets_auction_cases_4_and_5_output.csv",
          "interval": 1800,
          "limit": 168
        }
      ]
    },
    "double_assert": {
      "instances": [
        {
          "name": "double_assert_3",
          "parent": "Market_1",
          "in": "'2001-01-01 00:30:00'",
          "value": "assert_schedule",
          "within": 1e-05,
          "target": "current_market.clearing_price"
        },
        {
          "name": "double_assert_4",
          "parent": "Market_1",
          "value": 20,
          "within": 0.0001,
          "target": "current_price_mean_24h"
        },
        {
          "name": "double_assert_5",
          "parent": "Market_1",
          "value": 0,
          "within": 0.0001,
          "target": "current_price_stdev_24h"
        },
        {
          "name": "double_assert_7",
          "parent": "Market_1",
          "value": 0,
          "target": "current_market.marginal_quantity",
          "within": 1e-05
        }
      ]
    },
    "enum_assert": {
      "instances": [
        {
          "name": "enum_assert_6",
          "parent": "Market_1",
          "in": "'2001-01-01 00:30:00'",
          "value": 3,
          "target": "current_market.clearing_type"
        }
      ]
    },
    "auction": {
      "instances": [
        {
          "name": "Market_1",
          "unit": "MWh",
          "period": 1800,
          "verbose": true,
          "special_mode": "NONE",
          "warmup": 0,
          "init_price": 20.0001,
          "init_stdev": 1e-06
        }
      ]
    },
    "stub_bidder": {
      "instances": [
        {
          "name": "buyer_1",
          "role": "BUYER",
          "bid_period": 300,
          "market": "Market_1",
          "price": "buyer_price*1",
          "quantity": "buyer_quantity*1",
          "count": 10000
        },
        {
          "name": "buyer_2",
          "role": "BUYER",
          "bid_period": 1800,
          "market": "Market_1",
          "price": "buyer_2_price*1",
          "quantity": "buyer_quantity*1",
          "count": 10000
        },
        {
          "name": "seller_1",
          "role": "SELLER",
          "bid_period": 1800,
          "market": "Market_1",
          "price": "seller_1_price*1",
          "quantity": "seller_quantity*1",
          "count": 10000
        },
        {
          "name": "seller_2",
          "role": "SELLER",
          "bid_period": 1800,
          "market": "Market_1",
          "price": "seller_2_price*1",
          "quantity": "seller_quantity*1",
          "count": 10000
        }
      ]
    }
  },
  "schedules": {
    "buyer_price": [
      {
        "name": "",
        "items": [
          "* 0-12 * * * 25",
          "* 13-23 * * * 30"
        ]
      }
    ],
    "buyer_2_price": [
      {
        "name": "",
        "items": [
          "* 0-12 * * * 20",
          "* 13-23 * * * 10"
        ]
      }
    ],
    "seller_1_price": [
      {
        "name": "",
        "items": [
          "* 0-12 * * * 10",
          "* 13-23 * * * 15"
        ]
      }
    ],
    "seller_2_price": [
      {
        "name": "",
        "items": [
          "* 0-12 * * * 30",
          "* 13-23 * * * 20"
        ]
      }
    ],
    "buyer_quantity": [
      {
        "name": "",
        "items": [
          "* * * * * 1"
        ]
      }
    ],
    "seller_quantity": [
      {
        "name": "",
        "items": [
          "* * * * * 1"
        ]
      }
    ],
    "assert_schedule": [
      {
        "name": "",
        "items": [
          "30-59 0 * * * 20.0001",
          "* 1-12 * * * 20.0001",
          "0-29 13 * * * 20.0001",
          "30-59 13 * * * 19.9999",
          "* 14-23 * * * 19.9999",
          "0-29 0 * * * 19.9999"
        ]
      }
    ]
  }
}