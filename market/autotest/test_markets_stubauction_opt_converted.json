{
  "__preamble": {
    "comments": [
      "// test_markets_stubauction.glm contains validation for the calculation",
      "// of all rolling averages and standard deviations within the stubauction module",
      "// d3y334"
    ]
  },
  "_directives": {
    "#set": {
      "tmp": "../test_markets_stubauction_opt"
    }
  },
  "_legacy": {
    "#setenv": [
      "GRIDLABD=../../../core"
    ]
  },
  "clock": {
    "timezone": "PST+8PDT",
    "starttime": "'2001-01-01 00:00:00'",
    "stoptime": "'2001-03-01 01:00:00'"
  },
  "modules": {
    "market": {},
    "tape": {},
    "assert": {}
  },
  "objects": {
    "recorder": {
      "instances": [
        {
          "name": "recorder_2",
          "parent": "stubauction_1",
          "property": "next.P,last.P,avg24,std24,avg72,std72,avg168,std168",
          "file": "test_markets_stubauction.csv",
          "interval": 3600,
          "limit": 8760
        }
      ]
    },
    "double_assert": {
      "instances": [
        {
          "name": "double_assert_3",
          "parent": "stubauction_1",
          "target": "next.P",
          "status": "ASSERT_TRUE",
          "value": "price_signal*1",
          "within": 0.1
        },
        {
          "name": "double_assert_4",
          "parent": "stubauction_1",
          "target": "last.P",
          "in": "'2001-01-01 1:00:00'",
          "status": "ASSERT_TRUE",
          "value": "last_P_check*1",
          "within": 0.1
        },
        {
          "name": "double_assert_5",
          "parent": "stubauction_1",
          "target": "avg24",
          "in": "'2001-01-03 00:00:00'",
          "status": "ASSERT_TRUE",
          "value": 35,
          "within": 0.1
        },
        {
          "name": "double_assert_6",
          "parent": "stubauction_1",
          "target": "avg72",
          "in": "'2001-01-05 00:00:00'",
          "status": "ASSERT_TRUE",
          "value": 35,
          "within": 0.1
        },
        {
          "name": "double_assert_7",
          "parent": "stubauction_1",
          "target": "avg168",
          "in": "'2001-01-09 00:00:00'",
          "status": "ASSERT_TRUE",
          "value": 35,
          "within": 0.1
        },
        {
          "name": "double_assert_8",
          "parent": "stubauction_1",
          "target": "std168",
          "in": "'2001-01-09 00:00:00'",
          "status": "ASSERT_TRUE",
          "value": 17.0783,
          "within": 0.0001
        },
        {
          "name": "double_assert_9",
          "parent": "stubauction_1",
          "target": "std72",
          "in": "'2001-01-05 00:00:00'",
          "status": "ASSERT_TRUE",
          "value": 17.0783,
          "within": 0.0001
        },
        {
          "name": "double_assert_10",
          "parent": "stubauction_1",
          "target": "std24",
          "in": "'2001-01-03 00:00:00'",
          "status": "ASSERT_TRUE",
          "value": 17.0783,
          "within": 0.0001
        }
      ]
    },
    "stubauction": {
      "instances": [
        {
          "name": "stubauction_1",
          "period": 3600,
          "next.P": "price_signal*1"
        }
      ]
    }
  },
  "schedules": {
    "price_signal": [
      {
        "name": "",
        "items": [
          "* 0-3 * * * 10",
          "* 4-7 * * * 20",
          "* 8-11 * * * 30",
          "* 12-15 * * * 40",
          "* 16-19 * * * 50",
          "* 20-23 * * * 60"
        ]
      }
    ],
    "last_P_check": [
      {
        "name": "",
        "items": [
          "* 1-4 * * * 10",
          "* 5-8 * * * 20",
          "* 9-12 * * * 30",
          "* 13-16 * * * 40",
          "* 17-20 * * * 50",
          "* 21-0 * * * 60"
        ]
      }
    ]
  }
}