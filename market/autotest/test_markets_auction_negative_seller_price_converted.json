{
  "__preamble": {
    "comments": [
      "//This file tests that the clearing prices are valid when",
      "//one of the sellers bids a negative price",
      "//Bidding period: 3600 s",
      "//Buyer1: bid: 78, quantity: 5, period: 3600 s",
      "//Buyer2: bid: 63, quantity: 5, period: 3600 s",
      "//Buyer3: bid: 50, quantity: 5, period: 3600 s",
      "//Seller1: bid 110, quantity: 5, period: 3600 s",
      "//Seller2: bid 127, quantity: 5, period: 3600 s",
      "//Seller3: bid -120, quantity: 5, period: 3600 s",
      "//Expected clearing price: 63.0001",
      "//Expected clearing quantity: 5",
      "//The market should be NULL (case 8) but seller3",
      "//bids a negative quantity so 5 MWh are sold to",
      "//buyer1 for 63.0001 (case 5)"
    ]
  },
  "_directives": {
    "#define": {
      "stylesheet": "http://gridlab-d.svn.sourceforge.net/viewvc/gridlab-d/trunk/core/gridlabd-2_0"
    },
    "#set": {
      "tmp": "../test_markets_auction_negative_seller_price"
    }
  },
  "_legacy": {
    "#setenv": [
      "GRIDLABD=../../../core"
    ]
  },
  "classes": {
    "auction": [
      {
        "type": "double",
        "name": "current_price_mean_24h"
      },
      {
        "type": "double",
        "name": "current_price_stdev_24h"
      }
    ]
  },
  "clock": {
    "timezone": "PST+8PDT",
    "starttime": "'2001-01-01 00:00:00'",
    "stoptime": "'2001-01-03 00:00:00'"
  },
  "modules": {
    "market": {},
    "tape": {},
    "assert": {}
  },
  "objects": {
    "multi_recorder": {
      "instances": [
        {
          "parent": "Market_1",
          "property": "current_market.clearing_price,current_market.clearing_quantity,current_price_mean_24h,current_price_stdev_24h,buyer1:price,buyer1:quantity,buyer2:price,buyer2:quantity,buyer3:price,buyer3:quantity,seller1:price,seller1:quantity,seller2:price,seller2:quantity,seller3:price,seller3:quantity",
          "file": "test_markets_auction_negative_seller_price_output.csv",
          "interval": 3600,
          "limit": 168
        }
      ]
    },
    "double_assert": {
      "instances": [
        {
          "parent": "Market_1",
          "in": "'2001-01-01 01:00:00'",
          "value": 63.0001,
          "within": 0.0001,
          "target": "current_market.clearing_price",
          "inline_comments": {
            "value": "//78.0001 instead"
          }
        },
        {
          "parent": "Market_1",
          "in": "'2001-01-01 01:00:00'",
          "value": 5,
          "within": 1e-05,
          "target": "current_market.clearing_quantity"
        },
        {
          "parent": "Market_1",
          "value": 63.0001,
          "within": 0.0001,
          "target": "current_price_mean_24h",
          "inline_comments": {
            "value": "//78.0001 instead"
          }
        },
        {
          "parent": "Market_1",
          "value": 0,
          "within": 1e-05,
          "target": "current_price_stdev_24h"
        },
        {
          "parent": "Market_1",
          "value": 0,
          "target": "current_market.marginal_quantity",
          "within": 1e-05
        }
      ]
    },
    "enum_assert": {
      "instances": [
        {
          "parent": "Market_1",
          "in": "'2001-01-01 01:00:00'",
          "value": 3,
          "target": "current_market.clearing_type"
        }
      ]
    },
    "auction": {
      "instances": [
        {
          "name": "Market_1",
          "unit": "MWh",
          "period": 3600,
          "verbose": true,
          "special_mode": "NONE",
          "warmup": 0,
          "init_price": 63.0001,
          "init_stdev": 1e-06
        }
      ]
    },
    "stub_bidder": {
      "instances": [
        {
          "name": "buyer1",
          "role": "BUYER",
          "bid_period": 3600,
          "market": "Market_1",
          "price": 63,
          "quantity": 5,
          "count": 10000
        },
        {
          "name": "buyer2",
          "role": "BUYER",
          "bid_period": 3600,
          "market": "Market_1",
          "price": 78,
          "quantity": 5,
          "count": 10000
        },
        {
          "name": "buyer3",
          "role": "BUYER",
          "bid_period": 3600,
          "market": "Market_1",
          "price": 50,
          "quantity": 5,
          "count": 10000
        },
        {
          "name": "seller1",
          "role": "SELLER",
          "bid_period": 3600,
          "market": "Market_1",
          "price": 110,
          "quantity": 5,
          "count": 10000
        },
        {
          "name": "seller2",
          "role": "SELLER",
          "bid_period": 3600,
          "market": "Market_1",
          "price": -120,
          "quantity": 5,
          "count": 10000
        },
        {
          "name": "seller3",
          "role": "SELLER",
          "bid_period": 3600,
          "market": "Market_1",
          "price": 127,
          "quantity": 5,
          "count": 10000
        }
      ]
    }
  }
}